---
import '../styles/global.css';
import { tools, groups, groupKey } from '../data/tools';
import { site } from '../data/site';

const { title, description = '속도체크, IP 조회, 도메인 조회, 글자수 세기, 네이버 블로그 노출 확인까지. 자주 쓰는 웹 도구 모음.' } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} - 자주 쓰는 웹 도구 모음`;
const path = Astro.url.pathname;
const primary = tools.filter((t) => t.primary);
const footLinks = [
  { href: '/about/', label: '서비스 소개' },
  { href: '/privacy/', label: '개인정보처리방침' },
  { href: '/terms/', label: '이용약관' },
  { href: '/contact/', label: '문의하기' },
];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.min.css" />
  </head>
  <body>
    <header class="site">
      <div class="wrap nav">
        <a href="/" class="logo"><i>T</i>{site.name}</a>
        <ul>
          {primary.map((t) => (
            <li class="hide-m"><a class="link" href={`/tools/${t.slug}/`} aria-current={path.startsWith(`/tools/${t.slug}/`) ? 'page' : undefined}>{t.short}</a></li>
          ))}
          <li>
            <details class="menu" id="menu">
              <summary>전체 도구</summary>
              <div class="menu-panel">
                {groups.map((g) => (
                  <div class={`gx g-${groupKey[g]}`}>
                    <h4>{g}</h4>
                    {tools.filter((t) => t.group === g).map((t) => <a href={`/tools/${t.slug}/`}>{t.name}</a>)}
                  </div>
                ))}
              </div>
            </details>
          </li>
        </ul>
        <span></span>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site">
      <div class="wrap foot">
        <span>© 2026 {site.name}</span>
        <nav>{footLinks.map((l) => <a href={l.href}>{l.label}</a>)}</nav>
      </div>
    </footer>
    <script>
      const menu = document.getElementById('menu') as HTMLDetailsElement | null;
      document.addEventListener('click', (e) => { if (menu && !menu.contains(e.target as Node)) menu.open = false; });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && menu) menu.open = false; });
    </script>
  </body>
</html>
