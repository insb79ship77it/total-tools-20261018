---
import ToolPage from '../../layouts/ToolPage.astro';
---
<ToolPage title="도메인 WHOIS 조회" description="도메인의 등록일, 만료일, 등록기관, 네임서버를 확인하는 도메인 WHOIS 조회." lead="도메인을 입력하면 등록일, 만료일, 등록기관, 네임서버를 보여줍니다.">
  <div class="card panel">
    <div class="row">
      <input id="d-q" class="field" type="text" placeholder="도메인 입력 (예: example.com)" aria-label="도메인" autocomplete="off" />
      <button id="d-go" class="btn btn-primary" type="button">조회하기</button>
    </div>
    <p class="err" id="d-err" hidden></p>
    <dl class="kv" id="d-info" hidden></dl>
  </div>
  <Fragment slot="guide">
    <h2>조회 결과 읽는 법</h2>
    <p>만료일이 가까우면 연장하지 않을 경우 사이트와 이메일이 멈출 수 있어요. 네임서버는 도메인의 DNS를 관리하는 서버로, 호스팅이나 Cloudflare 같은 서비스를 쓰는지 알 수 있습니다.</p>
    <h3>참고하세요</h3>
    <p>WHOIS의 최신 표준인 RDAP로 조회하며, 개인정보 보호 정책 때문에 소유자 이름과 연락처는 대부분 공개되지 않습니다. 일부 확장자는 조회를 지원하지 않을 수 있습니다.</p>
  </Fragment>
</ToolPage>

<script>
  import { $, esc } from '../../lib/dom';

  const fmt = (s: string) => {
    if (!s) return '-';
    const d = new Date(s);
    return isNaN(+d) ? s : d.toLocaleDateString('ko-KR', { timeZone: 'Asia/Seoul', year: 'numeric', month: 'long', day: 'numeric' });
  };
  const dleft = (s: string) => {
    const d = new Date(s);
    if (!s || isNaN(+d)) return '';
    const n = Math.ceil((+d - Date.now()) / 86400000);
    return n >= 0 ? ` (${n}일 남음)` : ` (${-n}일 지남)`;
  };

  async function run() {
    const err = $('d-err');
    const info = $('d-info');
    err.hidden = info.hidden = true;
    const q = $<HTMLInputElement>('d-q').value.trim();
    if (!q) { err.textContent = '도메인을 입력하세요.'; err.hidden = false; return; }
    const btn = $<HTMLButtonElement>('d-go');
    btn.disabled = true;
    btn.textContent = '조회 중…';
    try {
      const res = await fetch(`/api/whois?domain=${encodeURIComponent(q)}`);
      const d = await res.json();
      if (!res.ok || d.error) throw new Error(d.error || '조회에 실패했습니다.');
      const rows: [string, string][] = [
        ['도메인', esc(d.domain)],
        ['등록기관', esc(d.registrar || '-')],
        ['등록일', fmt(d.created)],
        ['만료일', fmt(d.expires) + dleft(d.expires)],
        ['최종 변경일', fmt(d.updated)],
        ['네임서버', d.nameservers.length ? d.nameservers.map(esc).join('<br>') : '-'],
        ['상태', d.status.length ? d.status.map((s: string) => `<span class="badge b-gray">${esc(s)}</span>`).join(' ') : '-'],
        ['DNSSEC', d.dnssec === null ? '-' : d.dnssec ? '사용' : '미사용'],
      ];
      info.innerHTML = rows.map(([l, v]) => `<dt>${l}</dt><dd>${v}</dd>`).join('');
      info.hidden = false;
    } catch (e) {
      err.textContent = (e as Error).message;
      err.hidden = false;
    }
    btn.disabled = false;
    btn.textContent = '조회하기';
  }
  $('d-go').addEventListener('click', run);
  $('d-q').addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') run(); });
</script>
