---
import ToolPage from '../../layouts/ToolPage.astro';
---
<ToolPage title="파비콘 만들기" description="배경색과 글자로 파비콘을 만들어 SVG, ICO, PNG로 내려받는 파비콘 생성기." lead="글자와 색만 고르면 브라우저 탭에 쓰는 파비콘을 바로 만들어 줍니다.">
  <div class="card panel">
    <div class="two">
      <div class="controls">
        <label class="lbl" for="f-text">글자</label>
        <input id="f-text" class="field" type="text" value="T" autocomplete="off" />

        <div class="two2">
          <div>
            <label class="lbl" for="f-bg-hex">배경색</label>
            <div class="color-row">
              <input type="color" id="f-bg" value="#0057ff" aria-label="배경색 선택" />
              <input id="f-bg-hex" class="field" type="text" value="#0057ff" maxlength="7" />
            </div>
          </div>
          <div>
            <label class="lbl" for="f-fg-hex">글자색</label>
            <div class="color-row">
              <input type="color" id="f-fg" value="#ffffff" aria-label="글자색 선택" />
              <input id="f-fg-hex" class="field" type="text" value="#ffffff" maxlength="7" />
            </div>
          </div>
        </div>

        <p class="lbl">모양</p>
        <div class="seg" id="f-shape">
          <button type="button" class="on" data-shape="round">둥근 사각형</button>
          <button type="button" data-shape="circle">원</button>
          <button type="button" data-shape="square">사각형</button>
        </div>

        <label class="lbl" for="f-size">글자 크기 <span class="hint" id="f-size-v">60%</span></label>
        <input id="f-size" type="range" min="10" max="90" value="60" />
      </div>

      <div>
        <div class="prev">
          <canvas id="prev-lg" width="128" height="128" aria-label="파비콘 미리보기"></canvas>
          <div class="prev-small">
            <canvas id="prev-md" width="32" height="32"></canvas>
            <canvas id="prev-sm" width="16" height="16"></canvas>
            <span class="hint">실제 크기</span>
          </div>
        </div>
        <div class="btns">
          <button type="button" class="btn btn-primary btn-sm" id="d-svg">SVG</button>
          <button type="button" class="btn btn-primary btn-sm" id="d-ico">ICO</button>
          <button type="button" class="btn btn-ghost btn-sm" id="d-32">PNG 32</button>
          <button type="button" class="btn btn-ghost btn-sm" id="d-180">PNG 180 (애플)</button>
          <button type="button" class="btn btn-ghost btn-sm" id="d-512">PNG 512</button>
        </div>
      </div>
    </div>

    <label class="lbl mt" for="snippet">사이트에 넣는 코드</label>
    <textarea id="snippet" class="field" readonly style="min-height:96px;font-family:Consolas,monospace;font-size:.85rem">&lt;link rel="icon" href="/favicon.svg" type="image/svg+xml"&gt;
&lt;link rel="icon" href="/favicon.ico" sizes="48x48"&gt;
&lt;link rel="apple-touch-icon" href="/apple-touch-icon.png"&gt;</textarea>
    <div class="btns"><button type="button" class="btn btn-ghost btn-sm" id="copy-snippet">코드 복사</button></div>
  </div>

  <Fragment slot="guide">
    <h2>파비콘 적용하는 법</h2>
    <p>내려받은 파일을 사이트의 최상위 폴더(Astro라면 public 폴더)에 넣고, 위 코드를 페이지의 head 안에 붙여넣으세요. 파일 이름은 코드와 맞춰야 해요. SVG는 favicon.svg, ICO는 favicon.ico, 애플용 PNG 180은 apple-touch-icon.png로 저장하면 됩니다.</p>
    <h3>잘 보이는 파비콘 팁</h3>
    <p>파비콘은 16픽셀 안팎으로 아주 작게 보입니다. 글자는 1~2자로 짧게, 배경과 글자의 색 차이는 크게 하면 잘 보여요. SVG에 들어가는 글자는 방문자 기기의 글꼴로 그려지고, ICO와 PNG는 지금 보이는 모양 그대로 저장됩니다.</p>
    <h3>저장 안내</h3>
    <p>이미지는 모두 내 브라우저 안에서 만들어지며 서버로 전송되지 않습니다.</p>
  </Fragment>
</ToolPage>

<style>
  .two2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 16px; }
  .controls .lbl { margin-top: 16px; }
  .controls .lbl:first-child { margin-top: 0; }
  .color-row { display: flex; gap: 10px; }
  .color-row input[type='color'] { width: 52px; height: 52px; flex: none; padding: 4px; border: 1.5px solid #cfd8e8; border-radius: 12px; background: #fff; cursor: pointer; }
  .color-row .field { min-width: 0; }
  .prev { display: flex; align-items: flex-end; gap: 24px; padding: 28px; background: #f3f6fb; border-radius: 16px; }
  .prev canvas { display: block; }
  .prev-small { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  #f-size { width: 100%; accent-color: var(--blue); }
  @media (max-width: 760px) { .two2 { grid-template-columns: 1fr; } }
</style>

<script>
  import { copy } from '../../lib/dom';

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const FONT = '"Pretendard Variable", Pretendard, -apple-system, "Segoe UI", sans-serif';
  type Shape = 'round' | 'circle' | 'square';
  let shape: Shape = 'round';
  let sizeTouched = false;

  const val = (id: string) => $<HTMLInputElement>(id).value;
  const letters = () => val('f-text');
  const pct = () => Number(val('f-size')) / 100;

  function rr(ctx: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, r: number) {
    ctx.moveTo(x + r, y);
    ctx.arcTo(x + w, y, x + w, y + h, r);
    ctx.arcTo(x + w, y + h, x, y + h, r);
    ctx.arcTo(x, y + h, x, y, r);
    ctx.arcTo(x, y, x + w, y, r);
    ctx.closePath();
  }

  function paint(c: HTMLCanvasElement, size: number) {
    c.width = c.height = size;
    const ctx = c.getContext('2d')!;
    ctx.clearRect(0, 0, size, size);
    ctx.fillStyle = val('f-bg');
    ctx.beginPath();
    if (shape === 'circle') ctx.arc(size / 2, size / 2, size / 2, 0, Math.PI * 2);
    else if (shape === 'round') rr(ctx, 0, 0, size, size, size * 0.22);
    else ctx.rect(0, 0, size, size);
    ctx.fill();

    const t = letters();
    if (!t) return;
    ctx.fillStyle = val('f-fg');
    let fs = size * pct();
    ctx.font = `800 ${fs}px ${FONT}`;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'alphabetic';
    let m = ctx.measureText(t);
    if (m.width > size * 0.9) { // 글자가 길면 칸 안에 들어가게 줄입니다
      fs *= (size * 0.9) / m.width;
      ctx.font = `800 ${fs}px ${FONT}`;
      m = ctx.measureText(t);
    }
    ctx.fillText(t, size / 2, size / 2 + (m.actualBoundingBoxAscent - m.actualBoundingBoxDescent) / 2);
  }

  const escXml = (s: string) => s.replace(/[&<>]/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[m]!);
  function svgText() {
    const bg = val('f-bg');
    const form =
      shape === 'circle' ? `<circle cx="32" cy="32" r="32" fill="${bg}"/>`
      : `<rect width="64" height="64"${shape === 'round' ? ' rx="14"' : ''} fill="${bg}"/>`;
    const t = letters();
    const em = [...t].reduce((n, ch) => n + (ch.codePointAt(0)! > 0x2e80 ? 1 : 0.62), 0);
    const fs = Math.min(64 * pct(), 57.6 / Math.max(em, 1));
    const text = t
      ? `<text x="32" y="32" dy=".35em" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-weight="700" font-size="${fs.toFixed(1)}" fill="${val('f-fg')}">${escXml(t)}</text>`
      : '';
    return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">${form}${text}</svg>`;
  }

  function render() {
    $('f-size-v').textContent = `${val('f-size')}%`;
    paint($('prev-lg') as HTMLCanvasElement, 128);
    paint($('prev-md') as HTMLCanvasElement, 32);
    paint($('prev-sm') as HTMLCanvasElement, 16);
  }

  // 글자, 색, 모양, 크기 입력
  function onText() {
    const n = [...val('f-text')].length;
    if (!sizeTouched) $<HTMLInputElement>('f-size').value = String(n <= 1 ? 60 : n === 2 ? 48 : Math.max(10, Math.round(110 / n)));
    render();
  }
  $('f-text').addEventListener('input', onText);
  $('f-text').addEventListener('compositionend', onText);
  $('f-size').addEventListener('input', () => { sizeTouched = true; render(); });

  const normHex = (v: string) => {
    v = v.trim();
    if (!v.startsWith('#')) v = '#' + v;
    if (/^#[0-9a-fA-F]{3}$/.test(v)) v = '#' + [...v.slice(1)].map((c) => c + c).join('');
    return /^#[0-9a-fA-F]{6}$/.test(v) ? v.toLowerCase() : null;
  };
  for (const k of ['bg', 'fg']) {
    const color = $<HTMLInputElement>(`f-${k}`);
    const hex = $<HTMLInputElement>(`f-${k}-hex`);
    color.addEventListener('input', () => { hex.value = color.value; render(); });
    hex.addEventListener('input', () => { const n = normHex(hex.value); if (n) { color.value = n; render(); } });
  }
  $('f-shape').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
    if (!b) return;
    shape = b.dataset.shape as Shape;
    $('f-shape').querySelectorAll('button').forEach((x) => x.classList.toggle('on', x === b));
    render();
  });

  // 내려받기
  const pngBlob = (size: number) =>
    new Promise<Blob>((res) => {
      const c = document.createElement('canvas');
      paint(c, size);
      c.toBlob((b) => res(b!), 'image/png');
    });

  function save(blob: Blob, name: string) {
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = name;
    document.body.append(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  }

  // ICO: 여러 크기의 PNG를 하나의 파일로 묶습니다.
  async function icoBlob(sizes: number[]) {
    const pngs = await Promise.all(sizes.map(async (s) => new Uint8Array(await (await pngBlob(s)).arrayBuffer())));
    const head = 6 + 16 * sizes.length;
    const buf = new ArrayBuffer(head + pngs.reduce((n, p) => n + p.length, 0));
    const dv = new DataView(buf);
    dv.setUint16(0, 0, true);
    dv.setUint16(2, 1, true);
    dv.setUint16(4, sizes.length, true);
    let offset = head;
    sizes.forEach((s, i) => {
      const o = 6 + 16 * i;
      dv.setUint8(o, s >= 256 ? 0 : s);
      dv.setUint8(o + 1, s >= 256 ? 0 : s);
      dv.setUint16(o + 4, 1, true);
      dv.setUint16(o + 6, 32, true);
      dv.setUint32(o + 8, pngs[i].length, true);
      dv.setUint32(o + 12, offset, true);
      new Uint8Array(buf, offset, pngs[i].length).set(pngs[i]);
      offset += pngs[i].length;
    });
    return new Blob([buf], { type: 'image/x-icon' });
  }

  $('d-svg').addEventListener('click', () => save(new Blob([svgText()], { type: 'image/svg+xml' }), 'favicon.svg'));
  $('d-ico').addEventListener('click', async () => save(await icoBlob([16, 32, 48]), 'favicon.ico'));
  $('d-32').addEventListener('click', async () => save(await pngBlob(32), 'favicon-32x32.png'));
  $('d-180').addEventListener('click', async () => save(await pngBlob(180), 'apple-touch-icon.png'));
  $('d-512').addEventListener('click', async () => save(await pngBlob(512), 'icon-512.png'));
  $('copy-snippet').addEventListener('click', (e) => copy(($('snippet') as HTMLTextAreaElement).value, e.currentTarget as HTMLElement));

  render();
  // 글꼴이 준비되면 한 번 더 그립니다.
  document.fonts.load(`800 40px ${FONT}`, letters() || 'T').then(render).catch(() => {});
  document.fonts.ready.then(render);
</script>
