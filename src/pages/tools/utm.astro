---
import ToolPage from '../../layouts/ToolPage.astro';
---
<ToolPage title="UTM 생성기" description="마케팅 추적용 UTM 파라미터를 붙인 URL을 자동으로 만들어 주는 생성기." lead="주소와 캠페인 정보를 넣으면 UTM이 붙은 링크가 바로 만들어집니다.">
  <div class="card panel">
    <div class="form-grid">
      <div class="full">
        <label class="lbl" for="u-url">URL 주소 (필수)</label>
        <input id="u-url" class="field" type="text" placeholder="https://example.com/landing" />
      </div>
      <div>
        <label class="lbl" for="u-source">Source (필수)</label>
        <input id="u-source" class="field" type="text" placeholder="naver, newsletter" />
      </div>
      <div>
        <label class="lbl" for="u-medium">Medium</label>
        <input id="u-medium" class="field" type="text" placeholder="cpc, email, blog" />
      </div>
      <div>
        <label class="lbl" for="u-campaign">Campaign</label>
        <input id="u-campaign" class="field" type="text" placeholder="spring_sale" />
      </div>
      <div>
        <label class="lbl" for="u-term">Term</label>
        <input id="u-term" class="field" type="text" placeholder="검색 키워드" />
      </div>
      <div class="full">
        <label class="lbl" for="u-content">Content</label>
        <input id="u-content" class="field" type="text" placeholder="배너 A, 텍스트 링크" />
      </div>
      <div class="full">
        <label class="lbl" for="u-out">만들어진 링크</label>
        <textarea id="u-out" class="field" readonly style="min-height:96px"></textarea>
      </div>
    </div>
    <p class="err" id="u-err" hidden></p>
    <div class="btns">
      <button type="button" class="btn btn-primary btn-sm" id="u-copy">링크 복사</button>
    </div>
  </div>
  <Fragment slot="guide">
    <h2>UTM 항목 설명</h2>
    <p>Source는 트래픽이 온 곳(예: naver), Medium은 방식(예: cpc, email), Campaign은 캠페인 이름입니다. Term은 검색 광고 키워드, Content는 같은 캠페인 안에서 링크를 구분할 때 씁니다. 영문 소문자와 밑줄로 통일해 두면 분석할 때 편해요.</p>
  </Fragment>
</ToolPage>

<script>
  import { $, copy } from '../../lib/dom';
  const keys = ['source', 'medium', 'campaign', 'term', 'content'];
  const out = $<HTMLTextAreaElement>('u-out');
  const err = $('u-err');

  function build() {
    const raw = $<HTMLInputElement>('u-url').value.trim();
    const source = $<HTMLInputElement>('u-source').value.trim();
    err.hidden = true;
    if (!raw || !source) { out.value = ''; return; }
    let url: URL;
    try { url = new URL(/^https?:\/\//i.test(raw) ? raw : 'https://' + raw); }
    catch { out.value = ''; err.textContent = '올바른 URL 주소를 입력하세요.'; err.hidden = false; return; }
    for (const k of keys) {
      const v = $<HTMLInputElement>('u-' + k).value.trim();
      if (v) url.searchParams.set('utm_' + k, v); else url.searchParams.delete('utm_' + k);
    }
    out.value = url.toString();
  }
  ['url', ...keys].forEach((k) => $('u-' + k).addEventListener('input', build));
  $('u-copy').addEventListener('click', (e) => { if (out.value) copy(out.value, e.currentTarget as HTMLElement); });
</script>
