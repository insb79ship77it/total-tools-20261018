  const sheetsReady = Promise.all(fontLinks.map((l) => new Promise((r) => { l.onload = l.onerror = () => r(null); })));

  // Material 아이콘 글꼴: 용량이 커서 아이콘을 쓸 때 처음 한 번만 불러옵니다.
  const ICON_CSS = 'https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block';
