      ${chk(i, 'stroke', '테두리', s.stroke)}${clr(i, 'strokeColor', '테두리 색', s.strokeColor)}
      ${rng(i, 'strokeW', '테두리 두께', 0, 20, 0.5, s.strokeW)}<span></span>
      ${chk(i, 'shadow', '그림자', s.shadow)}${clr(i, 'shadowColor', '그림자 색', s.shadowColor)}
      ${rng(i, 'shadowBlur', '그림자 흐림', 0, 40, 1, s.shadowBlur)}${rng(i, 'shadowDist', '그림자 거리', 0, 30, 1, s.shadowDist)}
    </div></details>
    <details><summary>${POS[i]}배경 박스</summary><div class="img-grid">
      ${sel(i, 'box', '모양', [['none', '없음'], ['box', '박스 (글씨에 맞춤)'], ['band', '가로 전체 띠']], s.box)}${clr(i, 'boxColor', '박스 색', s.boxColor)}
      ${rng(i, 'boxAlpha', '박스 투명도(진하기)', 0, 100, 1, s.boxAlpha, '%')}${rng(i, 'boxRadius', '모서리 둥글기', 0, 100, 1, s.boxRadius, '%')}
      ${rng(i, 'padT', '위 간격', 0, 200, 5, s.padT, '%')}${rng(i, 'padB', '아래 간격', 0, 200, 5, s.padB, '%')}
      ${rng(i, 'padL', '왼쪽 간격', 0, 200, 5, s.padL, '%')}${rng(i, 'padR', '오른쪽 간격', 0, 200, 5, s.padR, '%')}
      <p class="hint" style="grid-column:1/-1;margin:0">간격은 글자 크기에 대한 비율이에요. (100% = 글자 한 칸)</p>
    </div></details>
    <details><summary>${POS[i]}이미지(로고)</summary><div class="img-grid">
      <label class="img-sel" style="grid-column:1/-1"><span>이미지 올리기 (PNG, JPG, SVG)</span><input type="file" accept="image/*" data-simg="${i}"></label>
      ${rng(i, 'imgSize', '이미지 크기', 2, 60, 0.5, s.imgSize, '%')}${sel(i, 'imgPos', '이미지 위치', [['left', '글씨 왼쪽'], ['top', '글씨 위'], ['bottom', '글씨 아래']], s.imgPos)}
      <button type="button" class="btn btn-ghost btn-sm" data-sclear="${i}">이미지 지우기</button><span class="hint" data-sname="${i}" style="margin:0"></span>
    </div></details>
    </div>
  </section>`).join('');

  $('sections').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button.img-fold') as HTMLButtonElement | null;
    if (!b) return;
    const body = b.closest('.img-sec')!.querySelector('.img-secbody') as HTMLElement;
    body.hidden = !body.hidden;
    b.textContent = body.hidden ? '열기 ▼' : '접기 ▲';
    b.setAttribute('aria-expanded', String(!body.hidden));
  });

  function renderLayers() {
    const front = [...order].reverse(); // 맨 앞 → 맨 뒤
    $('layer-list').innerHTML = front.map((si, pos) => {
      const tag = pos === 0 ? '맨 앞' : pos === front.length - 1 ? '맨 뒤' : '';
      return `<div class="img-layer"><span class="pos">${tag}</span><b>${TITLES[si]}</b>`
        + `<button type="button" data-lay="${si}" data-dir="up"${pos === 0 ? ' disabled' : ''}>▲ 앞으로</button>`
        + `<button type="button" data-lay="${si}" data-dir="down"${pos === front.length - 1 ? ' disabled' : ''}>▼ 뒤로</button></div>`;
    }).join('');
  }
  renderLayers();
  $('layer-list').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button[data-lay]') as HTMLButtonElement | null;
    if (!b || b.disabled) return;
    const k = order.indexOf(Number(b.dataset.lay));
    const j = b.dataset.dir === 'up' ? k + 1 : k - 1; // order의 뒤쪽일수록 앞에 그려져요
    if (j < 0 || j >= order.length) return;
    [order[k], order[j]] = [order[j], order[k]];
    renderLayers();
    schedule();
  });

  $('wm-panel').innerHTML = `<div class="img-grid">
    <label class="img-sel" style="grid-column:1/-1"><span>문구</span><input class="field" type="text" data-s="w" data-k="text" placeholder="비워두면 사용하지 않아요"></label>
    ${sel('w', 'font', '글꼴', FONT_OPTS, wm.font)}${sel('w', 'weight', '굵기', WEIGHTS, wm.weight)}
    ${clr('w', 'color', '글자색', wm.color)}${rng('w', 'size', '크기', 1, 15, 0.1, wm.size, '%')}
    ${rng('w', 'alpha', '진하기', 0, 100, 1, wm.alpha, '%')}${rng('w', 'angle', '기울기', -60, 60, 1, wm.angle, '°')}
    ${rng('w', 'gap', '간격', 0, 30, 0.5, wm.gap, '%')}
  </div>`;
  $('bgi-panel').innerHTML = `<div class="img-grid">
    <label class="img-sel" style="grid-column:1/-1"><span>아이콘 이름 (쉼표로 구분, 띄어쓰기 이름도 돼요)</span><input class="field" type="text" data-s="b" data-k="names" placeholder="비워두면 사용하지 않아요 (예: star, Check box, favorite)"></label>
    <div style="grid-column:1/-1">${iconPicker()}</div>
    ${clr('b', 'color', '아이콘 색', bgi.color)}${sel('b', 'weight', '굵기', [['300', '가늘게'], ['400', '보통'], ['700', '굵게']], bgi.weight)}
    ${rng('b', 'size', '크기', 1, 25, 0.5, bgi.size, '%')}${rng('b', 'alpha', '투명도(진하기)', 0, 100, 1, bgi.alpha, '%')}
    ${rng('b', 'gap', '간격', 0, 40, 0.5, bgi.gap, '%')}${rng('b', 'angle', '기울기', -60, 60, 1, bgi.angle, '°')}
    ${sel('b', 'layout', '배치', [['grid', '격자'], ['stagger', '엇갈림']], bgi.layout)}
  </div>`;

  // ---------- 입력 반영 ----------
  function onCtl(e: Event) {
    const el = e.target as HTMLInputElement;
    const si = el.dataset.s;
    const k = el.dataset.k;
    if (si === undefined || !k) return;
    const t = (si === 'w' ? wm : si === 'b' ? bgi : secs[Number(si)]) as any;
    t[k] = el.type === 'checkbox' ? el.checked : el.type === 'range' || k === 'weight' ? Number(el.value) : el.value;
    const b = el.closest('label')?.querySelector('b');
    if (b && el.type === 'range') b.textContent = el.value;
    schedule();
  }
  for (const id of ['sections', 'wm-panel', 'bgi-panel']) {
    $(id).addEventListener('input', onCtl);
    $(id).addEventListener('change', onCtl);
  }

  // ---------- 이미지 읽기 ----------
  async function decode(file: Blob): Promise<Img & { close: () => void }> {
    try {
      const bmp = await createImageBitmap(file);
      return { src: bmp, w: bmp.width, h: bmp.height, close: () => bmp.close() };
    } catch {
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.src = url;
      await img.decode();
      const w = img.naturalWidth || 1024;
      const h = img.naturalHeight || Math.round(w * 0.6667);
      return { src: img, w, h, close: () => URL.revokeObjectURL(url) };
    }
  }

  $('sections').addEventListener('change', async (e) => {
    const el = e.target as HTMLInputElement;
    if (el.dataset.simg === undefined || !el.files?.[0]) return;
    const i = Number(el.dataset.simg);
    try {
      const d = await decode(el.files[0]);
      secs[i].img = { src: d.src, w: d.w, h: d.h };
      document.querySelector(`[data-sname="${i}"]`)!.textContent = el.files[0].name;
    } catch {
      document.querySelector(`[data-sname="${i}"]`)!.textContent = '이미지를 읽지 못했어요';
    }
    schedule();
  });
  $('sections').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-sclear]');
    if (!b) return;
    const i = Number(b.dataset.sclear);
    secs[i].img = null;
    const input = document.querySelector<HTMLInputElement>(`input[data-simg="${i}"]`);
    if (input) input.value = '';
    document.querySelector(`[data-sname="${i}"]`)!.textContent = '';
    schedule();
  });

  // ---------- 아이콘 넣기 버튼 ----------
  // 글씨 칸을 떠나도 마지막 커서 위치를 기억해 둡니다. (버튼을 누르면 커서가 칸에서 빠지기 때문)
  const trackCaret = (e: Event) => {
    const t = e.target as HTMLTextAreaElement;
    if (t.tagName === 'TEXTAREA' && t.dataset.k === 'text') { t.dataset.caret = String(t.selectionStart); t.dataset.caretEnd = String(t.selectionEnd); }
  };
  ['keyup', 'click', 'input', 'select', 'focusout'].forEach((ev) => $('sections').addEventListener(ev, trackCaret));

  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button.mi[data-ic]');
    if (!b) return;
    const name = b.dataset.ic!;
    const sec = b.closest('.img-sec');
    if (sec) {
      // 글씨 칸의 커서 위치에 ((이름)) 을 넣습니다. (한 번도 누른 적 없으면 맨 끝에 붙여요)
      const ta = sec.querySelector<HTMLTextAreaElement>('textarea[data-k="text"]')!;
      const token = `((${name}))`;
      const a = ta.dataset.caret !== undefined ? Math.min(Number(ta.dataset.caret), ta.value.length) : ta.value.length;
      const z = ta.dataset.caretEnd !== undefined ? Math.min(Math.max(Number(ta.dataset.caretEnd), a), ta.value.length) : a;
      ta.setRangeText(token, a, z, 'end');
      ta.dataset.caret = ta.dataset.caretEnd = String(a + token.length);
      ta.dispatchEvent(new Event('input', { bubbles: true }));
    } else {
      // 아이콘 배경: 이름 칸 뒤에 쉼표로 이어 붙입니다.
      const inp = $('bgi-panel').querySelector<HTMLInputElement>('input[data-k="names"]')!;
      const cur = inp.value.trim().replace(/,\s*$/, '');
      const nm = name.replace(/_/g, ' ');
      inp.value = cur ? `${cur}, ${nm}` : nm;
      inp.dispatchEvent(new Event('input', { bubbles: true }));
    }
  });
  document.addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement;
    if (el.dataset?.icsearch === undefined) return;
    const q = iconName(el.value);
    el.closest('.img-icondet')!.querySelectorAll<HTMLElement>('button.mi').forEach((c) => (c.hidden = !!q && !c.dataset.name!.includes(q)));
  });
  // 아이콘 목록을 처음 펼칠 때 아이콘 글꼴을 불러옵니다.
  document.addEventListener('toggle', (e) => {
    const d = e.target as HTMLDetailsElement;
    if (d.classList?.contains('img-icondet') && d.open) loadIconFont();
  }, true);

  // ---------- 프리셋 (설정을 텍스트로 복사 · 붙여넣기) ----------
  // 적용한 값을 화면의 입력칸에도 똑같이 반영합니다.
  function syncControls() {
    document.querySelectorAll<HTMLInputElement>('[data-s][data-k]').forEach((el) => {
      const si = el.dataset.s!;
      const k = el.dataset.k!;
      const t = (si === 'w' ? wm : si === 'b' ? bgi : secs[Number(si)]) as any;
      if (!t || !(k in t)) return;
      if (el.type === 'checkbox') el.checked = !!t[k];
      else el.value = String(t[k]);
      const b = el.closest('label')?.querySelector('b');
      if (b && el.type === 'range') b.textContent = el.value;
      if (k === 'text') { delete el.dataset.caret; delete el.dataset.caretEnd; }
    });
  }
  const presetBox = () => $<HTMLTextAreaElement>('preset-text');
  const presetMsg = (text: string, ok = true) => {
    const m = $('preset-msg');
    m.textContent = text;
    m.style.color = ok ? 'var(--green)' : 'var(--red)';
  };
  const showPreset = () => { presetBox().value = toPresetText(secs, wm, bgi, order); };
  $('preset-show').addEventListener('click', () => { showPreset(); presetMsg('현재 설정을 가져왔어요. 복사해서 보관하세요.'); });
  $('preset-copy').addEventListener('click', async (e) => {
    if (!presetBox().value.trim()) showPreset();
    await copy(presetBox().value, e.currentTarget as HTMLElement);
  });
  const presetRange = (sid: string, k: string): [number, number] | null => {
    const el = document.querySelector<HTMLInputElement>(`[data-s="${sid}"][data-k="${k}"]`);
    return el && el.min !== '' && el.max !== '' ? [Number(el.min), Number(el.max)] : null;
  };
  // 프리셋 텍스트를 지금 설정에 적용하고 화면 입력칸도 맞춥니다.
  function applyText(text: string) {
    const res = applyPreset(text, secs, wm, bgi, presetRange, order);
    if (res.ok) { syncControls(); renderLayers(); schedule(); }
    return res;
  }
  $('preset-apply').addEventListener('click', () => {
    const res = applyText(presetBox().value);
    if (!res.ok) { presetMsg(res.error!, false); return; }
    presetMsg(`${res.count}개 설정을 적용했어요.`);
  });

  // ---- 내 프리셋 (아이디별 서버 저장, 최대 10개) ----
  type PItem = { id: string; name: string; savedAt: string; data: string };
  let psList: PItem[] = [];
  let psMax = 10;
  let psLoaded = false;
  const psMsg = (t: string, ok = true) => { const m = $('ps-msg'); m.textContent = t; m.style.color = ok ? 'var(--green)' : 'var(--red)'; };
  const psWhen = (iso: string) => new Date(iso).toLocaleString('ko-KR', { month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false });
  function renderPs() {
    $('ps-list').innerHTML = psList.length
      ? psList.map((p) => `<div class="ps-item" data-psid="${esc(p.id)}"><div class="ps-t"><b>${esc(p.name)}</b><small>${esc(psWhen(p.savedAt))}</small></div><button type="button" class="ps-b" data-psload>open</button><button type="button" class="ps-b del" data-psdel>del</button></div>`).join('')
      : '<p class="hint" style="margin:0">저장한 프리셋이 없어요.</p>';
  }
  async function psCall(method: string, qs = '', body?: unknown) {
    const res = await fetch('/api/presets' + qs, { method, headers: body ? { 'content-type': 'application/json' } : undefined, body: body ? JSON.stringify(body) : undefined });
    let d: any = {};
    try { d = await res.json(); } catch {}
    if (res.status === 401) throw new Error('login');
    if (!res.ok) throw new Error(d.error || `서버 오류 (HTTP ${res.status})`);
    psList = d.presets || [];
    psMax = d.max || 10;
    renderPs();
  }
  function psFail(e: unknown) {
    const m = (e as Error).message;
    if (m === 'login') {
      $('ps-msg').innerHTML = '로그인 후 사용할 수 있어요. <a href="/login/?next=/tools/image/" style="color:var(--blue);font-weight:700">로그인하기</a>';
      $('ps-msg').style.color = 'var(--red)';
    } else psMsg(m, false);
  }
  function psLoadOnce() {
    if (psLoaded) return;
    psLoaded = true;
    psCall('GET').then(() => psMsg(`저장된 프리셋 ${psList.length}/${psMax}개`)).catch((e) => { psLoaded = false; psFail(e); });
  }
  $('ps-reload').addEventListener('click', async () => {
    try { await psCall('GET'); psLoaded = true; psMsg(`새로고침했어요. 저장된 프리셋 ${psList.length}/${psMax}개`); } catch (e) { psLoaded = false; psFail(e); }
  });
  $('ps-save').addEventListener('click', async () => {
    const d = new Date();
    const base = $<HTMLInputElement>('ps-name').value.trim().slice(0, 24) || '프리셋';
    const name = `${base} ${pad2(d.getMonth() + 1)}/${pad2(d.getDate())} ${pad2(d.getHours())}:${pad2(d.getMinutes())}:${pad2(d.getSeconds())}`;
    try {
      await psCall('POST', '', { name, data: toPresetText(secs, wm, bgi, order) });
      $<HTMLInputElement>('ps-name').value = '';
      psLoaded = true;
      psMsg(`"${name}" 저장했어요. (${psList.length}/${psMax}개)`);
    } catch (e) { psFail(e); }
  });
  $('ps-list').addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    const row = t.closest<HTMLElement>('[data-psid]');
    const item = row && psList.find((p) => p.id === row.dataset.psid);
    if (!item) return;
    if (t.closest('[data-psload]')) {
      const res = applyText(item.data);
      psMsg(res.ok ? `"${item.name}" 프리셋을 불러왔어요.` : res.error!, res.ok);
    } else if (t.closest('[data-psdel]')) {
      if (!confirm(`"${item.name}" 프리셋을 삭제할까요?`)) return;
      try { await psCall('DELETE', `?id=${encodeURIComponent(item.id)}`); psMsg('삭제했어요.'); } catch (err) { psFail(err); }
    }
  });
  renderPs();

  // 칸이 비어 있으면 처음 펼칠 때 현재 설정을 보여주고, 저장한 프리셋 목록도 불러옵니다.
  document.addEventListener('toggle', (e) => {
    const d = e.target as HTMLDetailsElement;
    if (d.id === 'preset-det' && d.open) {
      if (!presetBox().value.trim()) showPreset();
      psLoadOnce();
    }
  }, true);

  // ---------- 파일 목록 ----------
  let files: File[] = [];
  let rows: HTMLElement[] = [];
  let running = false;
  let curIdx = -1;
  let pIdx = 0;
  let pvMode: 'file' | 'pattern' | 'card' = 'pattern'; // 미리보기가 보여주는 것: 선택한 파일 / 패턴 설정
  let lastSec: number | null = null;
  const dur = (n: number) => (n >= 60 ? `${Math.floor(n / 60)}분 ${n % 60}초` : `${n}초`);
  type Result = { name: string; blob: Blob; url: string };
  const resMap = new Map<File, Result>();
  const failSet = new Set<File>();
  const PART_BYTES = 200 * 1024 * 1024;
  const kb = (n: number) => (n >= 1048576 ? (n / 1048576).toFixed(1) + 'MB' : Math.max(1, Math.round(n / 1024)) + 'KB');

  function rowHtml(f: File, i: number) {
    const r = resMap.get(f);
    const state = r
      ? `<span class="st ok">${kb(r.blob.size)}</span><a class="dl" href="${r.url}" download="${esc(r.name)}">완료 저장</a>`
      : failSet.has(f) ? '<span class="st err">실패</span>'
      : running && curIdx === i ? '<span class="st">변환 중…</span>'
      : '<span class="st">대기</span>';
    return `<div class="img-file${pvMode === 'file' && i === pIdx ? ' on' : ''}" data-i="${i}"><span class="n" title="${esc(f.name)} · 눌러서 미리보기">${esc(f.name)}</span><span class="sz">${kb(f.size)}</span>${state}<button type="button" data-rm="${i}" aria-label="삭제">✕</button></div>`;
  }
  function updateRow(i: number) {
    const holder = document.createElement('div');
    holder.innerHTML = rowHtml(files[i], i);
    const el = holder.firstElementChild as HTMLElement;
    rows[i].replaceWith(el);
    rows[i] = el;
  }

  let zipParts: { name: string; blob: Blob }[][] = [];
  function buildZips() {
    zipParts = [];
    let cur: { name: string; blob: Blob }[] = [];
    let bytes = 0;
    for (const f of files) {
      const r = resMap.get(f);
      if (!r) continue;
      if (cur.length && bytes + r.blob.size > PART_BYTES) { zipParts.push(cur); cur = []; bytes = 0; }
      cur.push({ name: r.name, blob: r.blob });
      bytes += r.blob.size;
    }
    if (cur.length) zipParts.push(cur);
    $('zips').innerHTML = zipParts
      .map((p, n) => `<button type="button" class="btn btn-ghost btn-sm" data-zip="${n}">${zipParts.length > 1 ? `ZIP ${n + 1}` : 'ZIP으로 받기'} (${p.length}장 · ${kb(p.reduce((a, r) => a + r.blob.size, 0))})</button>`)
      .join('') + (zipParts.length && lastSec !== null ? `<span class="hint" style="margin:0;align-self:center">작업시간 ${dur(lastSec)}</span>` : '');
  }

  function renderFiles() {
    $('files').innerHTML = files.map(rowHtml).join('');
    rows = [...($('files').children as HTMLCollectionOf<HTMLElement>)];
    ($('clear-files') as HTMLElement).hidden = !files.length;
    ($('files-det') as HTMLElement).hidden = !files.length;
    $('files-sum').textContent = `작업 파일 ${files.length}장${resMap.size ? ` · 변환 완료 ${resMap.size}장` : ''} · 자세히 보기`;
    const run = $<HTMLButtonElement>('run');
    run.disabled = !files.length || running;
    run.textContent = files.length ? `변환 시작 (${files.length}장)` : '변환 시작';
    if (!resMap.size) {
      $('rstatus').textContent = files.length ? '설정을 맞추고 변환 시작을 누르세요.' : '이미지를 추가하면 변환할 수 있어요.';
      $('rprog').style.width = '0';
    }
    buildZips();
    updateNameExample();
  }

  function addFiles(list: FileList | File[] | null, focus = false) {
    if (running || !list) return;
    const seen = new Set(files.map((f) => `${f.name}|${f.size}|${f.lastModified}`));
    let added = 0;
    for (const f of Array.from(list)) {
      if (!f.type.startsWith('image/')) continue;
      const key = `${f.name}|${f.size}|${f.lastModified}`;
      if (seen.has(key)) continue;
      seen.add(key);
      files.push(f);
      added++;
    }
    if (!added) return;
    const firstNew = files.length - added;
    pvMode = 'file';
    if (firstNew === 0) pIdx = 0;
    if (focus) pIdx = firstNew; // 패턴으로 만든 이미지는 바로 미리보기로 보여줍니다
    renderFiles();
    loadPreview();
  }
  function dropResult(f: File) {
    const r = resMap.get(f);
    if (r) URL.revokeObjectURL(r.url);
    resMap.delete(f);
    failSet.delete(f);
    if (!resMap.size) lastSec = null;
  }

  $('file').addEventListener('change', (e) => { addFiles((e.target as HTMLInputElement).files); (e.target as HTMLInputElement).value = ''; });
  const drop = $('drop');
  ['dragenter', 'dragover'].forEach((ev) => drop.addEventListener(ev, (e) => { e.preventDefault(); drop.classList.add('over'); }));
  ['dragleave', 'drop'].forEach((ev) => drop.addEventListener(ev, (e) => { e.preventDefault(); drop.classList.remove('over'); }));
  drop.addEventListener('drop', (e) => addFiles((e as DragEvent).dataTransfer?.files || null));
  document.addEventListener('paste', (e) => addFiles(e.clipboardData?.files || null));
  $('files').addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const name = t.closest('.n');
    if (name) { pIdx = Number((name.closest('.img-file') as HTMLElement).dataset.i); pvMode = 'file'; loadPreview(); return; }
    const b = t.closest<HTMLButtonElement>('button[data-rm]');
    if (!b || running) return;
    const i = Number(b.dataset.rm);
    dropResult(files[i]);
    files.splice(i, 1);
    if (i < pIdx) pIdx--;
    renderFiles();
    loadPreview();
  });
  $('clear-files').addEventListener('click', () => {
    if (running) return;
    files.forEach(dropResult);
    files = [];
    pIdx = 0;
    renderFiles();
    loadPreview();
  });

  // ---------- 미리보기 ----------
  let prev: (Img & { close: () => void }) | null = null;
  let raf = 0;
  let token = 0;
  let loadToken = 0;

  function updateNav() {
    const fileMode = pvMode === 'file' && files.length > 0;
    ($('pv-nav') as HTMLElement).hidden = !(fileMode && files.length > 1);
    $('pv-count').textContent = `${pIdx + 1} / ${files.length}`;
    $('pv-name').textContent = fileMode ? `미리보기 · ${files[pIdx].name}`
      : files.length ? `미리보기 · ${pvMode === 'card' ? '카드뉴스 배경' : '배경 패턴'} 설정 중 (파일 이름을 누르면 그 이미지로 돌아가요)`
      : `미리보기 · ${pvMode === 'card' ? '카드뉴스 배경' : '배경 패턴'} (이미지를 추가하면 그 이미지로 보여줘요)`;
    ($('pv-dl') as HTMLElement).hidden = !(fileMode && resMap.has(files[pIdx]));
    rows.forEach((r, i) => r.classList.toggle('on', fileMode && i === pIdx));
  }
  async function svgToImg(svg: string, w: number, h: number) {
    const url = URL.createObjectURL(new Blob([svg], { type: 'image/svg+xml' }));
    const img = new Image();
    img.src = url;
    await img.decode();
    return { src: img as CanvasImageSource, w, h, close: () => URL.revokeObjectURL(url) };
  }
  async function loadPreview() {
    const my = ++loadToken;
    let next: (Img & { close: () => void }) | null = null;
    try {
      if (files.length && pvMode === 'file') {
        pIdx = Math.max(0, Math.min(pIdx, files.length - 1));
        next = await decode(files[pIdx]);
      } else if (pvMode === 'card') {
        if (!files.length) pIdx = 0;
        const [w, h] = cardDims();
        next = await svgToImg(cardSvg(cardState.active, w, h), w, h);
      } else {
        if (!files.length) pIdx = 0;
        const [w, h] = patDims();
        next = await svgToImg(patSvg(patState.active, w, h), w, h);
      }
    } catch { next = null; }
    if (my !== loadToken) { next?.close(); return; }
    if (prev) prev.close();
    prev = next;
    updateNav();
    updateCalc();
    schedule();
  }
  function toCard() { pvMode = 'card'; loadPreview(); }
  function toPattern() { pvMode = 'pattern'; loadPreview(); } // 패턴을 만지면 파일이 있어도 패턴 미리보기로
  $('pv-prev').addEventListener('click', () => { pIdx = (pIdx - 1 + files.length) % files.length; pvMode = 'file'; loadPreview(); });
  $('pv-next').addEventListener('click', () => { pIdx = (pIdx + 1) % files.length; pvMode = 'file'; loadPreview(); });
  $('pv-dl').addEventListener('click', () => {
    const r = files[pIdx] && resMap.get(files[pIdx]);
    if (!r) return;
    const a = document.createElement('a');
    a.href = r.url;
    a.download = r.name;
    document.body.append(a);
    a.click();
    a.remove();
  });

  async function ensureFonts() {
    const jobs: Promise<unknown>[] = [];
    const want = (font: string, weight: number, text: string) => {
      const f = fontStr(font, weight, 40);
      const t = text.replace(/[\[\]{}]/g, '') || 'Ab';
      try { if (!document.fonts.check(f, t)) jobs.push(document.fonts.load(f, t)); } catch {}
    };
    secs.forEach((s) => s.text.trim() && want(s.font, s.weight, s.text));
    if (wm.text.trim()) want(wm.font, wm.weight, wm.text);
    // Material 아이콘을 쓰는 경우에만 아이콘 글꼴을 불러옵니다.
    const names = [
      ...secs.flatMap((x) => [...x.text.matchAll(/\(\(([a-zA-Z0-9_ \-]+?)(?::#[0-9a-fA-F]{3,8})?\)\)/g)].map((m) => iconName(m[1]))),
      ...iconList(bgi.names),
    ];
    if (names.length) {
      await loadIconFont();
      let ok = false;
      try { ok = (await document.fonts.load(iconFontStr(400, 40), names.join(' '))).length > 0; } catch {}
      ($('icon-warn') as HTMLElement).hidden = ok;
    }
    await Promise.allSettled(jobs);
  }
  function schedule() {
    cancelAnimationFrame(raf);
    raf = requestAnimationFrame(drawPreview);
  }
  async function drawPreview() {
    const my = ++token;
    await ensureFonts();
    if (my !== token) return;
    const c = $('pv') as HTMLCanvasElement;
    const sw = prev ? prev.w : 1000;
    const sh = prev ? prev.h : 667;
    const W = Math.min(sw, 760);
    c.width = W;
    c.height = Math.max(1, Math.round((sh * W) / sw));
    compose(c.getContext('2d')!, prev ? prev.src : null, c.width, c.height, null, drawSecs(), wm, bgi);
  }
  document.fonts.ready.then(schedule);

  // ---------- 배경 패턴 ----------
  const patState = {
    sel: new Set<string>([PATTERNS[0][0]]),
    active: PATTERNS[0][0], // 미리보기에 보여줄 패턴 (마지막으로 누른 것)
    mode: 'solid', bg: '#243b6b', bg2: '#0b1530', angle: 135, fg: '#3d5a9c', scale: 1, alpha: 100,
    size: '1000x1000', cw: 1000, ch: 1000,
  };
  const bgSpec = () => (patState.mode === 'grad' ? `grad:${patState.bg}:${patState.bg2}:${patState.angle}` : patState.bg);
  const patSvg = (id: string, w: number, h: number) => makeSvg(id, bgSpec(), patState.fg, w, h, patState.scale, undefined, patState.alpha / 100);

  // 이미지 크기: 목록에서 고르거나 직접 입력 (50~4000px)
  function patDims(): [number, number] {
    if (patState.size === 'custom') {
      const c = (v: number) => Math.max(50, Math.min(4000, Math.round(v) || 1000));
      return [c(patState.cw), c(patState.ch)];
    }
    const [w, h] = patState.size.split('x').map(Number);
    return [w, h];
  }

  // 추천 색상: 네 가지 색이 한 묶음이에요. 밝기순으로 정렬해서 배경(어두운 쪽 2색)과 패턴색(그다음 색)에 넣습니다.
  const PALETTES: [string, string[]][] = [
    ['미드나이트 블루', ['#0f172a', '#1e3a5f', '#38bdf8', '#e0f2fe']],
    ['딥 포레스트', ['#10261f', '#1d4d3b', '#4ade80', '#ecfccb']],
    ['와인', ['#2b0f1c', '#5b1a35', '#e11d74', '#fde2ec']],
    ['차콜 골드', ['#1a1a1d', '#34343b', '#d4a72c', '#f5e6b3']],
    ['오션', ['#06283d', '#1363df', '#47b5ff', '#dff6ff']],
    ['선셋', ['#3d1e6d', '#c2185b', '#ff7a45', '#ffd166']],
    ['라벤더 나이트', ['#1b1535', '#4c3a8a', '#9b8cf0', '#ece8ff']],
    ['민트 나이트', ['#0d2b2b', '#11595a', '#2dd4bf', '#ccfbf1']],
    ['레드 블랙', ['#14090b', '#5c0f1d', '#e63946', '#fdebec']],
    ['블루 그레이', ['#263447', '#3d5a80', '#98c1d9', '#e8f4fa']],
    ['쿨 그레이', ['#1f2933', '#52606d', '#9aa5b1', '#e4e7eb']],
    ['네온 퍼플', ['#0b0b17', '#7c3aed', '#22d3ee', '#f0abfc']],
    ['네온 라임', ['#101010', '#1f2937', '#a3e635', '#facc15']],
    ['레트로', ['#2f3e46', '#52796f', '#e9b44c', '#f2e8cf']],
    ['빈티지 브라운', ['#3e2a21', '#7a5230', '#c9a66b', '#f1e4c3']],
    ['얼스 톤', ['#4a3f35', '#8c7a6b', '#bfae9f', '#efe6dd']],
    ['웜 크림', ['#5a3e2b', '#a47148', '#e0b88a', '#fff3e0']],
    ['로즈 골드', ['#4a2c3a', '#b76e79', '#e8b4b8', '#fbeaec']],
    ['코랄 피치', ['#ff6b6b', '#ffa07a', '#ffe0b2', '#fff5e6']],
    ['선라이즈', ['#ff9a3c', '#ffcb74', '#fff1b8', '#fffbe6']],
    ['파스텔 핑크', ['#ff9ebb', '#ffc2d4', '#ffd6e0', '#fff0f5']],
    ['파스텔 민트', ['#7bc8a4', '#a7e6cf', '#d4f1e4', '#f2fff9']],
    ['파스텔 퍼플', ['#b197fc', '#d0bfff', '#e9d8fd', '#f8f0ff']],
    ['파스텔 스카이', ['#8ec5ff', '#b3d9ff', '#d6ecff', '#f2f9ff']],
  ];
  let palActive = -1;
  const lum = (h: string) => {
    const n = parseInt(h.slice(1), 16);
    return 0.2126 * ((n >> 16) & 255) + 0.7152 * ((n >> 8) & 255) + 0.0722 * (n & 255);
  };
  function renderPals() {
    $('pal-grid').innerHTML = PALETTES.map(([name, cols], i) =>
      `<button type="button" class="pal${i === palActive ? ' on' : ''}" data-pal="${i}" title="${name} · ${cols.join(' ')}" aria-label="${name}">${cols.map((c) => `<i style="background:${c}"></i>`).join('')}</button>`).join('');
  }
  $('pal-grid').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-pal]');
    if (!b) return;
    palActive = Number(b.dataset.pal);
    const sorted = [...PALETTES[palActive][1]].sort((a, c) => lum(a) - lum(c));
    patState.bg = sorted[0];
    patState.bg2 = sorted[1];
    patState.fg = sorted[2];
    $<HTMLInputElement>('pat-bg').value = patState.bg;
    $<HTMLInputElement>('pat-bg2').value = patState.bg2;
    $<HTMLInputElement>('pat-fg').value = patState.fg;
    renderPals();
    patChanged();
  });

  function renderPats() {
    $('pat-grid').innerHTML = PATTERNS.map(([id, name]) => {
      const svg = makeSvg(id, bgSpec(), patState.fg, 150, 150, patState.scale, 30, patState.alpha / 100);
      return `<button type="button" class="pat${patState.sel.has(id) ? ' on' : ''}" data-pat="${id}" title="${name}" aria-label="${name}" aria-pressed="${patState.sel.has(id)}" style="background-image:url('data:image/svg+xml,${encodeURIComponent(svg)}')"></button>`;
    }).join('');
    const n = patState.sel.size;
    $('pat-count').textContent = `${n}개 선택`;
    $('pat-add').textContent = n > 1 ? `선택한 패턴 ${n}개로 이미지 추가` : '이 패턴으로 이미지 추가';
  }
  const patChanged = () => { renderPats(); toPattern(); };

  $('pat-grid').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-pat]');
    if (!b) return;
    const id = b.dataset.pat!;
    if (patState.sel.has(id) && patState.sel.size > 1) {
      patState.sel.delete(id);
      if (patState.active === id) patState.active = [...patState.sel].pop()!;
    } else {
      patState.sel.add(id);
      patState.active = id;
    }
    patChanged();
  });
  $('pat-all').addEventListener('click', () => { PATTERNS.forEach(([id]) => patState.sel.add(id)); patChanged(); });
  $('pat-none').addEventListener('click', () => { patState.sel = new Set([patState.active]); patChanged(); });

  const showBgMode = () => {
    const grad = patState.mode === 'grad';
    ($('pat-bg2-w') as HTMLElement).hidden = !grad;
    ($('pat-angle-w') as HTMLElement).hidden = !grad;
    $('pat-bg-l').textContent = grad ? '배경색 1' : '배경색';
  };
  $('pat-bgmode').addEventListener('change', (e) => { patState.mode = (e.target as HTMLSelectElement).value; showBgMode(); patChanged(); });
  $('pat-bg').addEventListener('input', (e) => { patState.bg = (e.target as HTMLInputElement).value; palActive = -1; renderPals(); patChanged(); });
  $('pat-bg2').addEventListener('input', (e) => { patState.bg2 = (e.target as HTMLInputElement).value; palActive = -1; renderPals(); patChanged(); });
  $('pat-fg').addEventListener('input', (e) => { patState.fg = (e.target as HTMLInputElement).value; palActive = -1; renderPals(); patChanged(); });
  $('pat-angle').addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement;
    patState.angle = Number(el.value);
    el.closest('label')!.querySelector('b')!.textContent = el.value;
    patChanged();
  });
  $('pat-scale').addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement;
    patState.scale = Number(el.value);
    el.closest('label')!.querySelector('b')!.textContent = el.value;
    patChanged();
  });

  $('pat-alpha').addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement;
    patState.alpha = Number(el.value);
    el.closest('label')!.querySelector('b')!.textContent = el.value;
    patChanged();
  });
  $('pat-size').addEventListener('change', (e) => {
    const v = (e.target as HTMLSelectElement).value;
    if (v === 'custom') {
      const [w, h] = patDims(); // 직접 입력으로 바꿀 때는 지금 크기에서 시작
      patState.cw = w;
      patState.ch = h;
      $<HTMLInputElement>('pat-w').value = String(w);
      $<HTMLInputElement>('pat-h').value = String(h);
    }
    patState.size = v;
    ['pat-w-w', 'pat-h-w', 'pat-custom-hint'].forEach((id) => (($(id) as HTMLElement).hidden = v !== 'custom'));
    toPattern();
  });
  $('pat-w').addEventListener('input', (e) => { patState.cw = Number((e.target as HTMLInputElement).value); toPattern(); });
  $('pat-h').addEventListener('input', (e) => { patState.ch = Number((e.target as HTMLInputElement).value); toPattern(); });
  const fixDims = () => {
    const [w, h] = patDims();
    $<HTMLInputElement>('pat-w').value = String(w);
    $<HTMLInputElement>('pat-h').value = String(h);
  };
  $('pat-w').addEventListener('change', fixDims);
  $('pat-h').addEventListener('change', fixDims);

  $('pat-add').addEventListener('click', () => {
    const [w, h] = patDims();
    const made = PATTERNS.filter(([id]) => patState.sel.has(id)).map(([id]) =>
      new File([patSvg(id, w, h)], `pattern-${id}-${w}x${h}.svg`, { type: 'image/svg+xml' }));
    addFiles(made, true);
  });

  // ---------- 카드뉴스 배경 ----------
  const cardState = {
    sel: new Set<string>([CARD_STYLES[0][0]]),
    active: CARD_STYLES[0][0], // 미리보기에 보여줄 스타일 (마지막으로 누른 것)
    c: { bg: '#cfe3f7', card: '#f7f9fc', accent: '#2f5bd9', sub: '#a9c9ee' },
    size: '1000x1000', cw: 1000, ch: 1000,
  };
  const cardSvg = (id: string, w: number, h: number) => makeCardSvg(id, cardState.c, w, h);
  function cardDims(): [number, number] {
    if (cardState.size === 'custom') {
      const c = (v: number) => Math.max(50, Math.min(4000, Math.round(v) || 1000));
      return [c(cardState.cw), c(cardState.ch)];
    }
    const [w, h] = cardState.size.split('x').map(Number);
    return [w, h];
  }

  // 추천 색상 네 가지를 역할에 나눠 담습니다. 가장 밝은 색=카드, 가장 선명한 색=포인트, 남은 둘 중 어두운 쪽=바탕, 밝은 쪽=보조
  const hsvSat = (h: string) => {
    const n = parseInt(h.slice(1), 16);
    const r = (n >> 16) & 255, g = (n >> 8) & 255, b = n & 255;
    const mx = Math.max(r, g, b);
    return mx ? (mx - Math.min(r, g, b)) / mx : 0;
  };
  function cardRoles(cols: string[]) {
    const byLum = [...cols].sort((a, b) => lum(a) - lum(b));
    const rest = byLum.slice(0, 3);
    const accent = rest.reduce((a, b) => (hsvSat(b) > hsvSat(a) ? b : a));
    const others = rest.filter((x) => x !== accent);
    return { card: byLum[3], accent, bg: others[0], sub: others[1] };
  }
  let cardPalActive = -1;
  function renderCardPals() {
    $('cpal-grid').innerHTML = PALETTES.map(([name, cols], i) =>
      `<button type="button" class="pal${i === cardPalActive ? ' on' : ''}" data-cpal="${i}" title="${name} · ${cols.join(' ')}" aria-label="${name}">${cols.map((c) => `<i style="background:${c}"></i>`).join('')}</button>`).join('');
  }
  $('cpal-grid').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-cpal]');
    if (!b) return;
    cardPalActive = Number(b.dataset.cpal);
    cardState.c = cardRoles(PALETTES[cardPalActive][1]);
    (['bg', 'card', 'accent', 'sub'] as const).forEach((k) => ($<HTMLInputElement>('card-c-' + k).value = cardState.c[k]));
    renderCardPals();
    cardChanged();
  });
  (['bg', 'card', 'accent', 'sub'] as const).forEach((k) =>
    $('card-c-' + k).addEventListener('input', (e) => {
      cardState.c[k] = (e.target as HTMLInputElement).value;
      cardPalActive = -1;
      renderCardPals();
      cardChanged();
    }));

  function renderCards() {
    $('card-grid').innerHTML = CARD_STYLES.map(([id, name]) => {
      const svg = makeCardSvg(id, cardState.c, 150, 150);
      return `<button type="button" class="pat${cardState.sel.has(id) ? ' on' : ''}" data-card="${id}" title="${name}" aria-label="${name}" aria-pressed="${cardState.sel.has(id)}" style="background-image:url('data:image/svg+xml,${encodeURIComponent(svg)}')"></button>`;
    }).join('');
    const n = cardState.sel.size;
    $('card-count').textContent = `${n}개 선택`;
    $('card-add').textContent = n > 1 ? `선택한 스타일 ${n}개로 이미지 추가` : '이 스타일로 이미지 추가';
  }
  const cardChanged = () => { renderCards(); toCard(); };
  $('card-grid').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-card]');
    if (!b) return;
    const id = b.dataset.card!;
    if (cardState.sel.has(id) && cardState.sel.size > 1) {
      cardState.sel.delete(id);
      if (cardState.active === id) cardState.active = [...cardState.sel].pop()!;
    } else {
      cardState.sel.add(id);
      cardState.active = id;
    }
    cardChanged();
  });
  $('card-all').addEventListener('click', () => { CARD_STYLES.forEach(([id]) => cardState.sel.add(id)); cardChanged(); });
  $('card-none').addEventListener('click', () => { cardState.sel = new Set([cardState.active]); cardChanged(); });

  $('card-size').addEventListener('change', (e) => {
    const v = (e.target as HTMLSelectElement).value;
    if (v === 'custom') {
      const [w, h] = cardDims();
      cardState.cw = w;
      cardState.ch = h;
      $<HTMLInputElement>('card-w').value = String(w);
      $<HTMLInputElement>('card-h').value = String(h);
    }
    cardState.size = v;
    ['card-w-w', 'card-h-w', 'card-custom-hint'].forEach((id) => (($(id) as HTMLElement).hidden = v !== 'custom'));
    toCard();
  });
  $('card-w').addEventListener('input', (e) => { cardState.cw = Number((e.target as HTMLInputElement).value); toCard(); });
  $('card-h').addEventListener('input', (e) => { cardState.ch = Number((e.target as HTMLInputElement).value); toCard(); });
  const fixCardDims = () => {
    const [w, h] = cardDims();
    $<HTMLInputElement>('card-w').value = String(w);
    $<HTMLInputElement>('card-h').value = String(h);
  };
  $('card-w').addEventListener('change', fixCardDims);
  $('card-h').addEventListener('change', fixCardDims);
  $('card-add').addEventListener('click', () => {
    const [w, h] = cardDims();
    const made = CARD_STYLES.filter(([id]) => cardState.sel.has(id)).map(([id]) =>
      new File([cardSvg(id, w, h)], `cardnews-${id}-${w}x${h}.svg`, { type: 'image/svg+xml' }));
    addFiles(made, true);
  });

  // ---------- 변환 ----------
  const fmtEl = $<HTMLSelectElement>('fmt');
  const qEl = $<HTMLInputElement>('quality');
  const syncQ = () => {
    $('q-v').textContent = qEl.value;
    qEl.disabled = fmtEl.value === 'png';
  };
  qEl.addEventListener('input', syncQ);
  fmtEl.addEventListener('change', syncQ);
  syncQ();

  // 크기 조절: 원본 유지 / 비율(%) / 최대 가로·세로(px)
  const rsMode = $<HTMLSelectElement>('rs-mode');
  const rsPct = $<HTMLInputElement>('rs-pct');
  function scaleFor(w: number, h: number) {
    if (rsMode.value === 'pct') return Math.max(0.01, Math.min(1, (Number(rsPct.value) || 100) / 100));
    if (rsMode.value === 'px') {
      const maxW = Number($<HTMLInputElement>('maxw').value) || Infinity;
      const maxH = Number($<HTMLInputElement>('maxh').value) || Infinity;
      return Math.min(1, maxW / w, maxH / h);
    }
    return 1;
  }
  // 미리보기 이미지를 기준으로 바뀔 가로×세로를 계산해서 보여줍니다.
  function updateCalc() {
    const el = $('rs-calc');
    if (!prev) { el.textContent = ''; return; }
    const sc = scaleFor(prev.w, prev.h);
    const w = Math.max(1, Math.round(prev.w * sc));
    const h = Math.max(1, Math.round(prev.h * sc));
    el.textContent = rsMode.value === 'none'
      ? `미리보기 이미지 ${prev.w}×${prev.h} → 원본 크기 그대로 저장`
      : `미리보기 이미지 ${prev.w}×${prev.h} → ${w}×${h}${rsMode.value === 'pct' ? ` (${rsPct.value}%)` : ''}로 저장`;
  }
  rsMode.addEventListener('change', () => {
    ($('rs-pct-w') as HTMLElement).hidden = rsMode.value !== 'pct';
    ($('rs-w-w') as HTMLElement).hidden = rsMode.value !== 'px';
    ($('rs-h-w') as HTMLElement).hidden = rsMode.value !== 'px';
    updateCalc();
  });
  rsPct.addEventListener('input', () => { $('rs-pct-v').textContent = rsPct.value; updateCalc(); });
  ['maxw', 'maxh'].forEach((id) => $(id).addEventListener('input', updateCalc));

  const MIME: Record<string, string> = { jpg: 'image/jpeg', png: 'image/png', webp: 'image/webp' };
  const EXT: Record<string, string> = { 'image/jpeg': 'jpg', 'image/png': 'png', 'image/webp': 'webp' };

  // ==NAME-START==
  // 파일 이름 = 이름(기존 또는 직접 지정) + 뒤에 붙일 글자 + 순번 + 날짜/시간 + 랜덤 4·5자리
  const nmMode = $<HTMLSelectElement>('nm-mode');
  const pad2 = (n: number) => String(n).padStart(2, '0');
  function stampText(d: Date, useDate: boolean, useTime: boolean) {
    const date = `${d.getFullYear()}${pad2(d.getMonth() + 1)}${pad2(d.getDate())}`;
    const time = `${pad2(d.getHours())}${pad2(d.getMinutes())}${pad2(d.getSeconds())}`;
    return [useDate ? date : '', useTime ? time : ''].filter(Boolean).join('_');
  }
  const cleanName = (t: string) => t.replace(/[\\/:*?"<>|]+/g, '_');
  function buildName(orig: string, idx: number, total: number, ext: string, d: Date, fixedRand?: string) {
    const custom = nmMode.value === 'custom';
    const base = cleanName(custom ? $<HTMLInputElement>('nm-base').value.trim() || 'image' : orig.replace(/\.[^.]+$/, ''));
    const suffix = cleanName($<HTMLInputElement>('suffix').value.trim());
    const seq = custom && $<HTMLInputElement>('nm-seq').checked && total > 1 ? `-${idx + 1}` : '';
    const st = stampText(d, $<HTMLInputElement>('nm-date').checked, $<HTMLInputElement>('nm-time').checked);
    const rn = Number($<HTMLSelectElement>('nm-rand').value);
    const rand = rn ? `_${fixedRand ? fixedRand.slice(0, rn) : String(Math.floor(Math.random() * 10 ** rn)).padStart(rn, '0')}` : '';
    return `${base}${suffix}${seq}${st ? '_' + st : ''}${rand}.${ext}`;
  }
  function updateNameExample() {
    const f = files[0];
    $('nm-example').textContent = `예시: ${buildName(f ? f.name : 'photo.jpg', 0, Math.max(files.length, 1), fmtEl.value, new Date(), '12345')}${$<HTMLSelectElement>('nm-rand').value !== '0' ? ' (랜덤 숫자는 예시)' : ''}`;
  }
  // 방식을 바꿔도 칸 위치가 움직이지 않게, 숨기지 않고 "직접 지정"일 때만 켭니다.
  function syncNameMode() {
    const custom = nmMode.value === 'custom';
    [['nm-base-w', 'nm-base'], ['nm-seq-w', 'nm-seq']].forEach(([w, i]) => {
      ($(i) as HTMLInputElement).disabled = !custom;
      ($(w) as HTMLElement).style.opacity = custom ? '1' : '0.45';
    });
    updateNameExample();
  }
  nmMode.addEventListener('change', syncNameMode);
  syncNameMode();
  ['nm-base', 'suffix', 'nm-date', 'nm-time', 'nm-rand', 'nm-seq'].forEach((id) => {
    $(id).addEventListener('input', updateNameExample);
    $(id).addEventListener('change', updateNameExample);
  });
  fmtEl.addEventListener('change', updateNameExample);
  // ==NAME-END==

  async function convert(file: File) {
    const fmt = fmtEl.value;
    const d = await decode(file);
    const scale = scaleFor(d.w, d.h);
    const W = Math.max(1, Math.round(d.w * scale));
    const H = Math.max(1, Math.round(d.h * scale));
    const c = document.createElement('canvas');
    c.width = W;
    c.height = H;
    compose(c.getContext('2d')!, d.src, W, H, fmt === 'jpg' ? $<HTMLInputElement>('bgc').value : null, drawSecs(), wm, bgi);
    d.close();
    const blob = await new Promise<Blob | null>((res) => c.toBlob(res, MIME[fmt], Number(qEl.value) / 100));
    c.width = c.height = 0;
    if (!blob) throw new Error('변환 실패');
    return blob;
  }

  async function run() {
    if (running || !files.length) return;
    running = true;
    files.forEach(dropResult);
    renderFiles();
    await ensureFonts();
    const runDate = new Date(); // 한 번에 변환하는 파일은 같은 날짜·시간을 씁니다
    let ok = 0, fail = 0, srcSum = 0, outSum = 0, warn = '';
    const t0 = Date.now();
    for (let i = 0; i < files.length; i++) {
      const f = files[i];
      curIdx = i;
      updateRow(i);
      $('rstatus').textContent = `${i + 1} / ${files.length}장 변환 중 · 소요시간 ${Math.round((Date.now() - t0) / 1000)}초`;
      try {
        const blob = await convert(f);
        const ext = EXT[blob.type] || fmtEl.value;
        if (blob.type !== MIME[fmtEl.value]) warn = '이 브라우저는 선택한 형식으로 저장하지 못해 PNG로 저장됐어요.';
        const name = buildName(f.name, i, files.length, ext, runDate);
        resMap.set(f, { name, blob, url: URL.createObjectURL(blob) });
        srcSum += f.size;
        outSum += blob.size;
        ok++;
      } catch {
        failSet.add(f);
        fail++;
      }
      curIdx = -1;
      updateRow(i);
      if (i === pIdx) updateNav();
      $('rprog').style.width = ((i + 1) / files.length) * 100 + '%';
      await new Promise((r) => setTimeout(r, 0)); // 화면이 멈추지 않게 한 템포 쉽니다
    }
    const sec = Math.round((Date.now() - t0) / 1000);
    lastSec = sec;
    $('rstatus').textContent = `완료 · ${ok}장 변환${fail ? `, ${fail}장 실패` : ''} · ${kb(srcSum)} → ${kb(outSum)} · 소요시간 ${sec}초${warn ? ' · ' + warn : ''}`;
    running = false;
    ($('run') as HTMLButtonElement).disabled = !files.length;
    buildZips();
    updateNav();
  }
  $('run').addEventListener('click', run);

  $('zips').addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-zip]');
    if (!b) return;
    const n = Number(b.dataset.zip);
    const old = b.textContent;
    b.disabled = true;
    b.textContent = 'ZIP 만드는 중…';
    // 같은 이름이 있으면 (2), (3)을 붙입니다.
    const used = new Map<string, number>();
    const items = zipParts[n].map((r) => {
      const c = (used.get(r.name) || 0) + 1;
      used.set(r.name, c);
      return { name: c > 1 ? r.name.replace(/(\.[^.]+)$/, `(${c})$1`) : r.name, blob: r.blob };
    });
    const zip = await makeZip(items);
    const a = document.createElement('a');
    a.href = URL.createObjectURL(zip);
    a.download = zipParts.length > 1 ? `images_${n + 1}.zip` : 'images.zip';
    document.body.append(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(a.href), 4000);
    b.disabled = false;
    b.textContent = old;
  });

  // 새 글꼴이 불러와지지 않으면 목록에 표시해 줍니다.
  async function checkCustomFonts() {
    await sheetsReady;
    for (const id of ['score', 'gmarket', 'paperlogy']) {
      let ok = false;
      try { ok = (await document.fonts.load(fontStr(id, 700, 24), '가A')).length > 0; } catch {}
      if (!ok) {
        document.querySelectorAll<HTMLOptionElement>(`select[data-k="font"] option[value="${id}"]`).forEach((o) => {
          if (!o.textContent!.includes('불러오기 실패')) o.textContent += ' (불러오기 실패)';
        });
      }
    }
    schedule();
  }

  renderPals();
  renderPats();
  renderCardPals();
  renderCards();
  renderFiles();
  loadPreview();
  sheetsReady.then(schedule);
  checkCustomFonts();
</script>
