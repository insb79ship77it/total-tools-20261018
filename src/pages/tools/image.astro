---
import ToolPage from '../../layouts/ToolPage.astro';
---
<ToolPage title="이미지 변환·글씨 넣기" description="여러 이미지를 JPG, PNG, WebP로 한꺼번에 변환하고 같은 문구를 상·중·하로 넣는 이미지 변환·글씨 넣기 도구." lead="이미지를 한꺼번에 변환하면서 같은 글씨를 넣을 수 있어요. 모든 작업은 내 브라우저 안에서만 이뤄집니다.">
  <div class="img-layout">
    <div class="img-stack">
      <div class="card panel">
        <label class="img-drop" id="drop" for="file">
          <b>이미지를 끌어다 놓거나 눌러서 선택</b>
          <span>JPG, PNG, WebP, GIF(첫 장), SVG · 여러 장 가능 · 붙여넣기(Ctrl+V)도 돼요</span>
        </label>
        <input id="file" type="file" accept="image/*" multiple hidden />
        <details class="img-pat" open>
          <summary>배경 패턴으로 이미지 만들기 (사진 없이 시작)</summary>
          <p class="hint" style="margin:0 0 8px">패턴을 여러 개 골라서 한 번에 이미지로 만들 수 있어요. (눌러서 선택·해제)</p>
          <div class="img-patgrid" id="pat-grid"></div>
          <div class="btns" style="margin:8px 0 0">
            <button type="button" class="btn btn-ghost btn-sm" id="pat-all">전체 선택</button>
            <button type="button" class="btn btn-ghost btn-sm" id="pat-none">선택 해제</button>
            <span class="hint" id="pat-count" style="margin:0;align-self:center"></span>
          </div>

          <div class="img-sub">
            <h4>추천 색상</h4>
            <p class="hint" style="margin:0 0 8px">눌러서 배경색과 패턴색에 한 번에 적용해요.</p>
            <div class="img-pal" id="pal-grid"></div>
          </div>

          <div class="img-sub">
            <h4>배경 방식</h4>
            <div class="img-grid">
              <label class="img-sel"><span>방식</span>
                <select class="field" id="pat-bgmode"><option value="solid">단색</option><option value="grad">그라데이션</option></select>
              </label>
              <label class="img-clr"><span id="pat-bg-l">배경색</span><input type="color" id="pat-bg" value="#243b6b" /></label>
              <label class="img-clr" id="pat-bg2-w" hidden><span>배경색 2</span><input type="color" id="pat-bg2" value="#0b1530" /></label>
              <label class="img-rng" id="pat-angle-w" hidden><span>그라데이션 각도 <b>135</b>°</span><input type="range" id="pat-angle" min="0" max="360" step="5" value="135" /></label>
            </div>
          </div>

          <div class="img-sub">
            <h4>패턴 방식</h4>
            <div class="img-grid">
              <label class="img-clr"><span>패턴색</span><input type="color" id="pat-fg" value="#3d5a9c" /></label>
              <label class="img-rng"><span>무늬 크기 <b>1</b>배</span><input type="range" id="pat-scale" min="0.4" max="3" step="0.1" value="1" /></label>
            </div>
          </div>

          <div class="img-sub">
            <h4>사이즈 설정</h4>
            <div class="img-grid">
              <label class="img-sel" style="grid-column:1/-1"><span>이미지 크기</span>
                <select class="field" id="pat-size">
                  <option value="1000x1000">정사각 1000×1000</option>
                  <option value="600x600">정사각 600×600</option>
                  <option value="1200x630">가로 1200×630</option>
                  <option value="700x467">가로 700×467</option>
                  <option value="1920x1080">16:9 1920×1080</option>
                  <option value="1080x1350">세로 1080×1350</option>
                  <option value="custom">직접 입력</option>
                </select>
              </label>
              <label class="img-sel" id="pat-w-w" hidden><span>가로 (px)</span><input class="field" type="number" id="pat-w" min="50" max="4000" value="1000" /></label>
              <label class="img-sel" id="pat-h-w" hidden><span>세로 (px)</span><input class="field" type="number" id="pat-h" min="50" max="4000" value="1000" /></label>
            </div>
            <p class="hint" id="pat-custom-hint" hidden style="margin:6px 0 0">50~4000px 사이로 입력하세요. 범위를 넘으면 자동으로 맞춰져요.</p>
            <button type="button" class="btn btn-primary btn-sm" id="pat-add" style="width:100%;margin-top:12px">이 패턴으로 이미지 추가</button>
          </div>
        </details>
        <div class="img-files" id="files"></div>
        <div class="btns"><button type="button" class="btn btn-ghost btn-sm" id="clear-files" hidden>모두 지우기</button></div>
      </div>

      <div class="card panel">
        <h2 class="img-h">글씨 넣기</h2>
        <p class="hint">상단·중단·하단마다 글씨, 크기, 색, 굵기, 이미지(로고)를 따로 정해요. 글씨를 비워두면 그 영역은 나오지 않아요.</p>
        <div id="sections"></div>
      </div>

      <div class="card panel">
        <h2 class="img-h">반복 워터마크 (선택)</h2>
        <p class="hint">문구를 입력하면 이미지 전체에 비스듬히 반복해서 깔려요.</p>
        <div id="wm-panel"></div>
      </div>

      <div class="card panel">
        <h2 class="img-h">저장 설정</h2>
        <div class="img-grid">
          <label class="img-sel"><span>저장 형식</span>
            <select class="field" id="fmt"><option value="jpg">JPG</option><option value="png">PNG</option><option value="webp">WebP</option></select>
          </label>
          <label class="img-rng"><span>화질 <b id="q-v">90</b></span><input type="range" id="quality" min="40" max="100" step="1" value="90" /></label>
          <label class="img-sel"><span>최대 가로 (px, 비우면 원본)</span><input class="field" id="maxw" type="number" min="1" placeholder="예: 1200" /></label>
          <label class="img-sel"><span>최대 세로 (px, 비우면 원본)</span><input class="field" id="maxh" type="number" min="1" placeholder="예: 1200" /></label>
          <label class="img-clr"><span>JPG 배경색 (투명한 부분)</span><input type="color" id="bgc" value="#ffffff" /></label>
          <label class="img-sel"><span>파일 이름 뒤에 붙일 글자</span><input class="field" id="suffix" type="text" placeholder="예: _thumb" /></label>
        </div>
      </div>
    </div>

    <div class="card panel img-side">
      <div class="img-pvhead">
        <div class="img-pvl"><span class="hint" id="pv-name">미리보기 · 이미지를 추가하면 첫 이미지로 보여줘요</span><button type="button" class="img-dl" id="pv-dl" hidden>다운로드</button></div>
        <div class="img-pvnav" id="pv-nav" hidden><button type="button" id="pv-prev" aria-label="이전">◀</button><span id="pv-count"></span><button type="button" id="pv-next" aria-label="다음">▶</button></div>
      </div>
      <div class="img-pvbox"><canvas id="pv" width="760" height="507" aria-label="미리보기"></canvas></div>
      <button type="button" class="btn btn-primary" id="run" style="width:100%" disabled>변환 시작</button>
      <div class="prog" style="margin-top:14px"><div id="rprog"></div></div>
      <p class="note" id="rstatus" style="margin:10px 0 0">이미지를 추가하면 변환할 수 있어요.</p>
      <div class="btns" id="zips"></div>
    </div>
  </div>

  <Fragment slot="guide">
    <h2>사용 방법</h2>
    <h3>글씨 강조</h3>
    <p>글씨 안에서 대괄호 두 개로 감싼 단어는 박스로 강조되고, 중괄호 두 개로 감싼 단어는 강조 글자색으로 바뀝니다. 예를 들어 대괄호 두 개 안에 단어를 넣으면 그 단어 뒤에 색 박스가 깔려요.</p>
    <h3>글씨 크기와 위치</h3>
    <p>글씨 크기는 이미지 가로 길이에 대한 비율이라서 이미지 크기가 달라도 같은 모양으로 들어갑니다. 위치도 이미지 전체에 대한 비율이에요.</p>
    <h3>저장</h3>
    <p>변환이 끝나면 파일마다 저장하거나 ZIP으로 받을 수 있어요. 수백 장이면 ZIP이 200MB 정도마다 나뉘어요. 이미지는 서버로 전송되지 않으며, 글꼴만 Google Fonts에서 불러옵니다.</p>
  </Fragment>
</ToolPage>

<style is:global>
  .img-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px; align-items: start; }
  .img-side { position: sticky; top: 84px; }
  .img-stack > .card { margin-bottom: 20px; }
  .img-h { margin: 0 0 6px; padding-left: 12px; border-left: 4px solid var(--blue); font-size: 1.3rem; font-weight: 800; color: var(--navy); }
  .img-drop { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 28px 16px; border: 2px dashed #b9ccf5; border-radius: 16px; background: #f7faff; color: var(--blue); cursor: pointer; text-align: center; }
  .img-drop.over { background: var(--soft); border-color: var(--blue); }
  .img-drop span { color: var(--muted); font-size: 0.85rem; }
  .img-files { margin-top: 12px; max-height: 260px; overflow: auto; border: 1px solid var(--line); border-radius: 12px; }
  .img-files:empty { display: none; }
  .img-file { display: flex; align-items: center; gap: 10px; padding: 8px 12px; border-bottom: 1px solid #edf1f7; font-size: 0.85rem; }
  .img-file:last-child { border-bottom: 0; }
  .img-file .n { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--navy); font-weight: 600; }
  .img-file .sz, .img-file .st { color: var(--muted); white-space: nowrap; }
  .img-file .st.ok { color: var(--green); font-weight: 700; }
  .img-file .st.err { color: var(--red); font-weight: 700; }
  .img-file a.dl { color: var(--blue); font-weight: 700; }
  .img-file button { border: 0; background: none; color: #8a94a8; cursor: pointer; font-size: 1rem; }
  .img-sec { padding: 20px 0; border-top: 1px solid var(--line); }
  .img-sec:first-child { border-top: 0; padding-top: 12px; }
  .img-sec h3 { display: flex; align-items: center; gap: 10px; margin: 0 0 14px; padding: 10px 14px; border-radius: 12px; background: var(--gb); color: var(--gc); font-size: 1.15rem; font-weight: 800; }
  .img-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 14px; margin-top: 12px; }
  .img-rng, .img-clr, .img-sel { display: flex; flex-direction: column; gap: 4px; font-size: 0.82rem; color: var(--muted); font-weight: 600; }
  .img-rng b { color: var(--navy); }
  .img-rng input { width: 100%; accent-color: var(--blue); }
  .img-clr input[type='color'] { width: 100%; height: 38px; padding: 3px; border: 1.5px solid #cfd8e8; border-radius: 10px; background: #fff; cursor: pointer; }
  .img-sel .field { padding: 8px 10px; font-size: 0.88rem; min-height: 0; }
  .img-chk { display: flex; align-items: center; gap: 8px; font-weight: 600; color: var(--navy); font-size: 0.88rem; }
  .img-sec details { margin-top: 12px; border: 1px solid var(--line); border-radius: 12px; padding: 0 14px; }
  .img-sec summary { cursor: pointer; padding: 10px 0; font-weight: 700; color: var(--navy); font-size: 0.9rem; }
  .img-sec details[open] summary { border-bottom: 1px solid var(--line); margin-bottom: 6px; }
  .img-sec details .img-grid { padding-bottom: 14px; }
  .img-sec textarea.field { min-height: 0; }
  .img-pvhead { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 10px; }
  .img-pvhead .hint { margin: 0; }
  .img-pvbox { background: repeating-conic-gradient(#eef1f6 0 25%, #fff 0 50%) 0 0 / 16px 16px; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; margin-bottom: 14px; }
  .img-pvbox canvas { display: block; width: 100%; height: auto; }
  .img-pvnav { display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: var(--muted); }
  .img-pvnav button { width: 30px; height: 30px; border: 1px solid var(--line); border-radius: 8px; background: #fff; cursor: pointer; }
  .img-pat { margin-top: 14px; border: 1px solid var(--line); border-radius: 12px; padding: 0 14px 14px; }
  .img-pat summary { cursor: pointer; padding: 12px 0; font-weight: 700; color: var(--navy); font-size: 0.92rem; }
  .img-patgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(50px, 1fr)); gap: 8px; max-height: 190px; overflow: auto; padding: 3px; }
  .img-patgrid .pat { position: relative; aspect-ratio: 1; padding: 0; border: 2px solid #fff; border-radius: 10px; background-size: cover; background-position: center; cursor: pointer; box-shadow: 0 0 0 1px var(--line); }
  .img-patgrid .pat.on { box-shadow: 0 0 0 3px var(--blue); }
  .img-patgrid .pat.on::after { content: '✓'; position: absolute; top: 3px; right: 3px; width: 18px; height: 18px; border-radius: 50%; background: var(--blue); color: #fff; font-size: 11px; line-height: 18px; text-align: center; font-weight: 800; }
  .img-sub { margin-top: 12px; padding: 12px 14px 14px; border: 1px solid var(--line); border-radius: 12px; background: #f7f9fd; }
  .img-sub h4 { display: flex; align-items: center; gap: 8px; margin: 0 0 8px; font-size: 0.88rem; font-weight: 800; color: var(--navy); }
  .img-sub h4::before { content: ''; width: 4px; height: 14px; border-radius: 2px; background: var(--blue); }
  .img-sub .img-grid { margin-top: 0; }
  .img-pal { display: grid; grid-template-columns: repeat(auto-fill, minmax(70px, 1fr)); gap: 8px; max-height: 132px; overflow: auto; padding: 3px; }
  .img-pal .pal { display: flex; height: 30px; padding: 0; overflow: hidden; border: 2px solid #fff; border-radius: 8px; box-shadow: 0 0 0 1px var(--line); cursor: pointer; }
  .img-pal .pal i { flex: 1; }
  .img-pal .pal.on { box-shadow: 0 0 0 2px var(--blue); }
  .img-file.on { background: #f3f7ff; }
  .img-file .n { cursor: pointer; }
  .img-file .n:hover { color: var(--blue); text-decoration: underline; }
  .img-file a.dl { padding: 3px 10px; border-radius: 8px; background: #e0f6ec; color: var(--green); white-space: nowrap; }
  .img-pvl { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .img-pvl .hint { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .img-dl { flex: none; border: 1px solid #cfe0ff; background: var(--soft); color: var(--blue); font: inherit; font-size: 0.78rem; font-weight: 700; padding: 3px 10px; border-radius: 8px; cursor: pointer; white-space: nowrap; }
  .img-dl:hover { background: #dbe7ff; }
  @media (max-width: 900px) { .img-layout { grid-template-columns: 1fr; } .img-side { position: static; order: -1; } }
</style>

<script>
  import { esc } from '../../lib/dom';

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;

  // ==RENDER-START==
  type Img = { src: CanvasImageSource; w: number; h: number };
  type Sec = {
    text: string; font: string; weight: number; size: number; color: string; accent: string; hl: string;
    lh: number; ls: number; align: 'left' | 'center' | 'right'; x: number; y: number;
    stroke: boolean; strokeColor: string; strokeW: number;
    shadow: boolean; shadowColor: string; shadowBlur: number; shadowDist: number;
    box: 'none' | 'box' | 'band'; boxColor: string; boxAlpha: number; boxRadius: number;
    img: Img | null; imgSize: number; imgPos: 'left' | 'top' | 'bottom';
  };
  type Wm = { text: string; font: string; weight: number; color: string; size: number; alpha: number; angle: number; gap: number };

  const FONTS = [
    { id: 'pretendard', name: '프리텐다드', css: '"Pretendard Variable", Pretendard' },
    { id: 'noto', name: '노토 산스', css: '"Noto Sans KR"' },
    { id: 'nanumg', name: '나눔고딕', css: '"Nanum Gothic"' },
    { id: 'nanumm', name: '나눔명조', css: '"Nanum Myeongjo"' },
    { id: 'pen', name: '나눔손글씨 펜', css: '"Nanum Pen Script"' },
    { id: 'blackhan', name: '블랙한산스', css: '"Black Han Sans"' },
    { id: 'jua', name: '주아', css: '"Jua"' },
    { id: 'dohyeon', name: '도현', css: '"Do Hyeon"' },
    { id: 'poppins', name: 'Poppins (영문)', css: '"Poppins"' },
    { id: 'montserrat', name: 'Montserrat (영문)', css: '"Montserrat"' },
  ];
  const fam = (id: string) => (FONTS.find((f) => f.id === id) || FONTS[0]).css + ', sans-serif';
  const hexA = (h: string, a: number) => {
    const n = parseInt(h.slice(1), 16);
    return `rgba(${(n >> 16) & 255},${(n >> 8) & 255},${n & 255},${a})`;
  };

  function rrect(ctx: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, r: number) {
    r = Math.max(0, Math.min(r, w / 2, h / 2));
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.arcTo(x + w, y, x + w, y + h, r);
    ctx.arcTo(x + w, y + h, x, y + h, r);
    ctx.arcTo(x, y + h, x, y, r);
    ctx.arcTo(x, y, x + w, y, r);
    ctx.closePath();
  }

  // [[강조 박스]] , {{강조 글자색}} 을 조각으로 나눕니다.
  type Run = { t: string; k: 'n' | 'a' | 'b' };
  function parseRuns(line: string): Run[] {
    const runs: Run[] = [];
    const re = /\[\[(.+?)\]\]|\{\{(.+?)\}\}/g;
    let last = 0;
    let m: RegExpExecArray | null;
    while ((m = re.exec(line))) {
      if (m.index > last) runs.push({ t: line.slice(last, m.index), k: 'n' });
      runs.push(m[1] !== undefined ? { t: m[1], k: 'b' } : { t: m[2], k: 'a' });
      last = re.lastIndex;
    }
    if (last < line.length) runs.push({ t: line.slice(last), k: 'n' });
    return runs;
  }

  function measure(ctx: CanvasRenderingContext2D, t: string, ls: number) {
    if (!ls) return ctx.measureText(t).width;
    let w = 0;
    for (const ch of t) w += ctx.measureText(ch).width + ls;
    return w;
  }

  function put(ctx: CanvasRenderingContext2D, t: string, x: number, y: number, ls: number, stroke: boolean) {
    const f = stroke ? ctx.strokeText.bind(ctx) : ctx.fillText.bind(ctx);
    if (!ls) { f(t, x, y); return; }
    let cx = x;
    for (const ch of t) { f(ch, cx, y); cx += ctx.measureText(ch).width + ls; }
  }

  function drawSection(ctx: CanvasRenderingContext2D, s: Sec, W: number, H: number) {
    const lines = s.text.replace(/\s+$/, '').split(/\r?\n/);
    const hasText = s.text.trim() !== '';
    if (!hasText && !s.img) return;

    const sc = W / 1000;
    const fs = (s.size / 100) * W;
    const lh = fs * s.lh;
    const ls = s.ls * sc;
    const hlPad = fs * 0.25;
    ctx.save();
    ctx.font = `${s.weight} ${fs}px ${fam(s.font)}`;
    ctx.textBaseline = 'middle';
    ctx.textAlign = 'left';

    const rows = hasText
      ? lines.map((l) => {
          const runs = parseRuns(l);
          const w = runs.reduce((a, r) => a + measure(ctx, r.t, ls) + (r.k === 'b' ? hlPad * 2 : 0), 0);
          return { runs, w };
        })
      : [];
    const textW = rows.reduce((a, r) => Math.max(a, r.w), 0);
    const textH = rows.length * lh;

    let iw = 0, ih = 0;
    if (s.img) { iw = (s.imgSize / 100) * W; ih = (iw * s.img.h) / s.img.w; }
    const gap = fs * 0.4;
    let cw: number, ch: number;
    if (!s.img) { cw = textW; ch = textH; }
    else if (!rows.length) { cw = iw; ch = ih; }
    else if (s.imgPos === 'left') { cw = iw + gap + textW; ch = Math.max(ih, textH); }
    else { cw = Math.max(iw, textW); ch = ih + gap + textH; }

    const padX = fs * 0.8;
    const padY = fs * 0.35;
    const band = s.box === 'band';
    const bw = band ? W : cw + padX * 2;
    const bh = ch + padY * 2;
    const cx = (s.x / 100) * W;
    const cy = (s.y / 100) * H;
    const bx = band ? 0 : cx - bw / 2;
    const by = cy - bh / 2;
    const ox = band ? cx - cw / 2 : bx + padX;
    const oy = by + padY;

    if (s.box !== 'none') {
      ctx.save();
      ctx.globalAlpha = s.boxAlpha / 100;
      ctx.fillStyle = s.boxColor;
