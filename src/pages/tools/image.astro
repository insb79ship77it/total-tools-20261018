    face('GmarketSans', 500, GM + 'GmarketSansMedium.woff', 'woff'),
    face('GmarketSans', 700, GM + 'GmarketSansBold.woff', 'woff'),
    face('GmarketSans', 900, GM + 'GmarketSansBold.woff', 'woff'),
    faceOne('Hippie', PN + '2610081905@hippie/hippie/hippie_히피체.woff2', 'woff2'),
    faceOne('JejuStoneWall', NN + 'noonfonts_2210-EF@1.0/EF_jejudoldam.woff2', 'woff2'),
    faceOne('Cafe24Dongdong', NN + 'noonfonts_twelve@1.1/Cafe24Dongdong.woff', 'woff'),
    faceOne('Cafe24SsongSsong', NN + 'noonfonts_twelve@1.1/Cafe24Syongsyong.woff', 'woff'),
    faceOne('SejongjaeumimoeumiColorColor', PN + '2611030019@color-1696-1553/color-1696-1553/SejongJaeumiMoeumi-Color_.woff2', 'woff2'),
    faceOne('Stella', PN + '2608201622@stellar-serif/stellar-serif/Stellar_Serif_Bold_Condensed.woff2', 'woff2'),
