  kfont.textContent = [
    face('Paperlogy', 400, PL + 'Paperlogy-4Regular.woff2', 'woff2'),
    face('Paperlogy', 500, PL + 'Paperlogy-5Medium.woff2', 'woff2'),
    face('Paperlogy', 700, PL + 'Paperlogy-7Bold.woff2', 'woff2'),
    face('Paperlogy', 900, PL + 'Paperlogy-9Black.woff2', 'woff2'),
