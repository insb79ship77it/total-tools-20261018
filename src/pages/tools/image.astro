  const sel = (i: string | number, k: string, label: string, opts: [string, string][], val: string | number) =>
    `<label class="img-sel"><span>${label}</span><select class="field" data-s="${i}" data-k="${k}">${opts.map(([v, t]) => `<option value="${v}"${v === String(val) ? ' selected' : ''}>${t}</option>`).join('')}</select></label>`;
  const chk = (i: string | number, k: string, label: string, val: boolean) =>
    `<label class="img-chk"><input type="checkbox" data-s="${i}" data-k="${k}"${val ? ' checked' : ''}> ${label}</label>`;
  const FONT_OPTS: [string, string][] = FONTS.map((f) => [f.id, f.name]);
  const WEIGHTS: [string, string][] = [['400', '가늘게'], ['500', '보통'], ['700', '굵게'], ['900', '아주 굵게']];

  // 자주 쓰는 아이콘 (눌러서 글씨 칸에 넣는 버튼)
  const ICON_NAMES = ['star', 'favorite', 'check', 'check_box', 'check_circle', 'done_all', 'thumb_up', 'lightbulb', 'bolt', 'local_fire_department', 'campaign', 'notifications', 'info', 'help', 'warning', 'error', 'arrow_forward', 'arrow_right_alt', 'trending_up', 'verified', 'workspace_premium', 'emoji_events', 'rocket_launch', 'savings', 'payments', 'shopping_cart', 'sell', 'redeem', 'schedule', 'calendar_month', 'location_on', 'call', 'mail', 'link', 'search', 'visibility', 'download', 'edit', 'home', 'person', 'group', 'school', 'menu_book', 'sentiment_satisfied', 'celebration', 'tips_and_updates', 'auto_awesome', 'shield', 'lock', 'play_circle', 'photo_camera', 'music_note', 'restaurant', 'flight', 'directions_car', 'pets', 'eco', 'wifi', 'cloud', 'sunny', 'diamond'];
  const chips = ICON_NAMES.map((n) => `<button type="button" class="mi" data-ic="${n}" data-name="${n}" title="${n.replace(/_/g, ' ')}">${n}</button>`).join('');
  const iconPicker = (pre = '') => `<details class="img-icondet"><summary>${pre}아이콘 넣기 (눌러서 추가)</summary><input class="field" type="search" data-icsearch placeholder="이름으로 찾기 (예: star, check box)" style="margin-bottom:8px"><div class="img-icons">${chips}</div></details>`;

  const POS = ['상단 · ', '중단 · ', '하단 · ', '추가 · '];
  const TITLES = ['상단 텍스트', '중단 텍스트', '하단 텍스트', '추가 텍스트'];
  const SEC_CLS = ['g-net', 'g-blog', 'g-dev', 'g-text'];
  $('sections').innerHTML = secs.map((s, i) => `<section class="img-sec ${SEC_CLS[i]}">
