  const wm: Wm = { text: '', font: 'pretendard', weight: 700, color: '#ffffff', size: 4, alpha: 22, angle: -30, gap: 8 };

  // ---------- 설정 화면 만들기 ----------
  const rng = (i: string | number, k: string, label: string, min: number, max: number, step: number, val: number, unit = '') =>
    `<label class="img-rng"><span>${label} <b>${val}</b>${unit}</span><input type="range" data-s="${i}" data-k="${k}" min="${min}" max="${max}" step="${step}" value="${val}"></label>`;
  const clr = (i: string | number, k: string, label: string, val: string) =>
    `<label class="img-clr"><span>${label}</span><input type="color" data-s="${i}" data-k="${k}" value="${val}"></label>`;
  const sel = (i: string | number, k: string, label: string, opts: [string, string][], val: string | number) =>
    `<label class="img-sel"><span>${label}</span><select class="field" data-s="${i}" data-k="${k}">${opts.map(([v, t]) => `<option value="${v}"${v === String(val) ? ' selected' : ''}>${t}</option>`).join('')}</select></label>`;
  const chk = (i: string | number, k: string, label: string, val: boolean) =>
    `<label class="img-chk"><input type="checkbox" data-s="${i}" data-k="${k}"${val ? ' checked' : ''}> ${label}</label>`;
  const FONT_OPTS: [string, string][] = FONTS.map((f) => [f.id, f.name]);
  const WEIGHTS: [string, string][] = [['400', '가늘게'], ['500', '보통'], ['700', '굵게'], ['900', '아주 굵게']];

  const TITLES = ['상단 · 작은 글씨', '중단 · 큰 글씨', '하단 · 작은 글씨'];
  const SEC_CLS = ['g-net', 'g-blog', 'g-dev'];
  $('sections').innerHTML = secs.map((s, i) => `<section class="img-sec ${SEC_CLS[i]}">
    <h3>${TITLES[i]}</h3>
    <textarea class="field" rows="${i === 1 ? 3 : 2}" data-s="${i}" data-k="text" placeholder="비워두면 이 영역은 나오지 않아요">${esc(s.text)}</textarea>
    <p class="hint">여러 줄 가능 · [[단어]] 박스 강조 · {{단어}} 강조 글자색</p>
    <div class="img-grid">
      ${sel(i, 'font', '글꼴', FONT_OPTS, s.font)}${sel(i, 'weight', '굵기', WEIGHTS, s.weight)}
      ${clr(i, 'color', '글자색', s.color)}${sel(i, 'align', '정렬', [['left', '왼쪽'], ['center', '가운데'], ['right', '오른쪽']], s.align)}
      ${rng(i, 'size', '크기', 1, 25, 0.1, s.size, '%')}${rng(i, 'lh', '줄 간격', 0.8, 2, 0.05, s.lh)}
      ${rng(i, 'ls', '자간', -5, 20, 0.5, s.ls)}${rng(i, 'y', '세로 위치', 0, 100, 0.5, s.y, '%')}
      ${rng(i, 'x', '가로 위치', 0, 100, 0.5, s.x, '%')}
    </div>
    <details><summary>강조 · 테두리 · 그림자</summary><div class="img-grid">
      ${clr(i, 'hl', '박스 강조 배경색', s.hl)}${clr(i, 'accent', '강조 글자색', s.accent)}
      ${chk(i, 'stroke', '테두리', s.stroke)}${clr(i, 'strokeColor', '테두리 색', s.strokeColor)}
      ${rng(i, 'strokeW', '테두리 두께', 0, 20, 0.5, s.strokeW)}<span></span>
      ${chk(i, 'shadow', '그림자', s.shadow)}${clr(i, 'shadowColor', '그림자 색', s.shadowColor)}
      ${rng(i, 'shadowBlur', '그림자 흐림', 0, 40, 1, s.shadowBlur)}${rng(i, 'shadowDist', '그림자 거리', 0, 30, 1, s.shadowDist)}
    </div></details>
    <details><summary>배경 박스</summary><div class="img-grid">
      ${sel(i, 'box', '모양', [['none', '없음'], ['box', '박스 (글씨에 맞춤)'], ['band', '가로 전체 띠']], s.box)}${clr(i, 'boxColor', '박스 색', s.boxColor)}
      ${rng(i, 'boxAlpha', '박스 투명도(진하기)', 0, 100, 1, s.boxAlpha, '%')}${rng(i, 'boxRadius', '모서리 둥글기', 0, 100, 1, s.boxRadius, '%')}
    </div></details>
    <details><summary>이미지(로고)</summary><div class="img-grid">
      <label class="img-sel" style="grid-column:1/-1"><span>이미지 올리기 (PNG, JPG, SVG)</span><input type="file" accept="image/*" data-simg="${i}"></label>
      ${rng(i, 'imgSize', '이미지 크기', 2, 60, 0.5, s.imgSize, '%')}${sel(i, 'imgPos', '이미지 위치', [['left', '글씨 왼쪽'], ['top', '글씨 위'], ['bottom', '글씨 아래']], s.imgPos)}
      <button type="button" class="btn btn-ghost btn-sm" data-sclear="${i}">이미지 지우기</button><span class="hint" data-sname="${i}" style="margin:0"></span>
    </div></details>
  </section>`).join('');

  $('wm-panel').innerHTML = `<div class="img-grid">
    <label class="img-sel" style="grid-column:1/-1"><span>문구</span><input class="field" type="text" data-s="w" data-k="text" placeholder="비워두면 사용하지 않아요"></label>
    ${sel('w', 'font', '글꼴', FONT_OPTS, wm.font)}${sel('w', 'weight', '굵기', WEIGHTS, wm.weight)}
    ${clr('w', 'color', '글자색', wm.color)}${rng('w', 'size', '크기', 1, 15, 0.1, wm.size, '%')}
    ${rng('w', 'alpha', '진하기', 0, 100, 1, wm.alpha, '%')}${rng('w', 'angle', '기울기', -60, 60, 1, wm.angle, '°')}
    ${rng('w', 'gap', '간격', 0, 30, 0.5, wm.gap, '%')}
  </div>`;

  // ---------- 입력 반영 ----------
  function onCtl(e: Event) {
    const el = e.target as HTMLInputElement;
    const si = el.dataset.s;
    const k = el.dataset.k;
    if (si === undefined || !k) return;
    const t = (si === 'w' ? wm : secs[Number(si)]) as any;
    t[k] = el.type === 'checkbox' ? el.checked : el.type === 'range' || k === 'weight' ? Number(el.value) : el.value;
    const b = el.closest('label')?.querySelector('b');
    if (b && el.type === 'range') b.textContent = el.value;
    schedule();
  }
  for (const id of ['sections', 'wm-panel']) {
    $(id).addEventListener('input', onCtl);
    $(id).addEventListener('change', onCtl);
  }

  // ---------- 이미지 읽기 ----------
  async function decode(file: Blob): Promise<Img & { close: () => void }> {
    try {
      const bmp = await createImageBitmap(file);
      return { src: bmp, w: bmp.width, h: bmp.height, close: () => bmp.close() };
    } catch {
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.src = url;
      await img.decode();
      const w = img.naturalWidth || 1024;
      const h = img.naturalHeight || Math.round(w * 0.6667);
      return { src: img, w, h, close: () => URL.revokeObjectURL(url) };
    }
  }

  $('sections').addEventListener('change', async (e) => {
    const el = e.target as HTMLInputElement;
    if (el.dataset.simg === undefined || !el.files?.[0]) return;
    const i = Number(el.dataset.simg);
    try {
      const d = await decode(el.files[0]);
      secs[i].img = { src: d.src, w: d.w, h: d.h };
      document.querySelector(`[data-sname="${i}"]`)!.textContent = el.files[0].name;
    } catch {
      document.querySelector(`[data-sname="${i}"]`)!.textContent = '이미지를 읽지 못했어요';
    }
    schedule();
  });
  $('sections').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-sclear]');
    if (!b) return;
    const i = Number(b.dataset.sclear);
    secs[i].img = null;
    const input = document.querySelector<HTMLInputElement>(`input[data-simg="${i}"]`);
    if (input) input.value = '';
    document.querySelector(`[data-sname="${i}"]`)!.textContent = '';
    schedule();
  });

  // ---------- 파일 목록 ----------
  let files: File[] = [];
  let rows: HTMLElement[] = [];
  let running = false;
  let curIdx = -1;
  let pIdx = 0;
  type Result = { name: string; blob: Blob; url: string };
  const resMap = new Map<File, Result>();
  const failSet = new Set<File>();
  const PART_BYTES = 200 * 1024 * 1024;
  const kb = (n: number) => (n >= 1048576 ? (n / 1048576).toFixed(1) + 'MB' : Math.max(1, Math.round(n / 1024)) + 'KB');

  function rowHtml(f: File, i: number) {
    const r = resMap.get(f);
    const state = r
      ? `<span class="st ok">${kb(r.blob.size)}</span><a class="dl" href="${r.url}" download="${esc(r.name)}">완료 저장</a>`
      : failSet.has(f) ? '<span class="st err">실패</span>'
      : running && curIdx === i ? '<span class="st">변환 중…</span>'
      : '<span class="st">대기</span>';
    return `<div class="img-file${i === pIdx ? ' on' : ''}" data-i="${i}"><span class="n" title="${esc(f.name)} · 눌러서 미리보기">${esc(f.name)}</span><span class="sz">${kb(f.size)}</span>${state}<button type="button" data-rm="${i}" aria-label="삭제">✕</button></div>`;
  }
  function updateRow(i: number) {
    const holder = document.createElement('div');
    holder.innerHTML = rowHtml(files[i], i);
    const el = holder.firstElementChild as HTMLElement;
    rows[i].replaceWith(el);
    rows[i] = el;
  }

  let zipParts: { name: string; blob: Blob }[][] = [];
  function buildZips() {
    zipParts = [];
    let cur: { name: string; blob: Blob }[] = [];
    let bytes = 0;
    for (const f of files) {
      const r = resMap.get(f);
      if (!r) continue;
      if (cur.length && bytes + r.blob.size > PART_BYTES) { zipParts.push(cur); cur = []; bytes = 0; }
      cur.push({ name: r.name, blob: r.blob });
      bytes += r.blob.size;
    }
    if (cur.length) zipParts.push(cur);
    $('zips').innerHTML = zipParts
      .map((p, n) => `<button type="button" class="btn btn-ghost btn-sm" data-zip="${n}">${zipParts.length > 1 ? `ZIP ${n + 1}` : 'ZIP으로 받기'} (${p.length}장 · ${kb(p.reduce((a, r) => a + r.blob.size, 0))})</button>`)
      .join('');
  }

  function renderFiles() {
    $('files').innerHTML = files.map(rowHtml).join('');
    rows = [...($('files').children as HTMLCollectionOf<HTMLElement>)];
    ($('clear-files') as HTMLElement).hidden = !files.length;
    const run = $<HTMLButtonElement>('run');
    run.disabled = !files.length || running;
    run.textContent = files.length ? `변환 시작 (${files.length}장)` : '변환 시작';
    if (!resMap.size) {
      $('rstatus').textContent = files.length ? '설정을 맞추고 변환 시작을 누르세요.' : '이미지를 추가하면 변환할 수 있어요.';
      $('rprog').style.width = '0';
    }
    buildZips();
  }

  function addFiles(list: FileList | File[] | null) {
    if (running || !list) return;
    const seen = new Set(files.map((f) => `${f.name}|${f.size}|${f.lastModified}`));
    let added = 0;
    for (const f of Array.from(list)) {
      if (!f.type.startsWith('image/')) continue;
      const key = `${f.name}|${f.size}|${f.lastModified}`;
      if (seen.has(key)) continue;
      seen.add(key);
      files.push(f);
      added++;
    }
    if (!added) return;
    const wasEmpty = files.length === added;
    renderFiles();
    if (wasEmpty) { pIdx = 0; loadPreview(); }
    else updateNav();
  }
  function dropResult(f: File) {
    const r = resMap.get(f);
    if (r) URL.revokeObjectURL(r.url);
    resMap.delete(f);
    failSet.delete(f);
  }

  $('file').addEventListener('change', (e) => { addFiles((e.target as HTMLInputElement).files); (e.target as HTMLInputElement).value = ''; });
  const drop = $('drop');
  ['dragenter', 'dragover'].forEach((ev) => drop.addEventListener(ev, (e) => { e.preventDefault(); drop.classList.add('over'); }));
  ['dragleave', 'drop'].forEach((ev) => drop.addEventListener(ev, (e) => { e.preventDefault(); drop.classList.remove('over'); }));
  drop.addEventListener('drop', (e) => addFiles((e as DragEvent).dataTransfer?.files || null));
  document.addEventListener('paste', (e) => addFiles(e.clipboardData?.files || null));
  $('files').addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const name = t.closest('.n');
    if (name) { pIdx = Number((name.closest('.img-file') as HTMLElement).dataset.i); loadPreview(); return; }
    const b = t.closest<HTMLButtonElement>('button[data-rm]');
    if (!b || running) return;
    const i = Number(b.dataset.rm);
    dropResult(files[i]);
    files.splice(i, 1);
    if (i < pIdx) pIdx--;
    renderFiles();
    loadPreview();
  });
  $('clear-files').addEventListener('click', () => {
    if (running) return;
    files.forEach(dropResult);
    files = [];
    pIdx = 0;
    renderFiles();
    loadPreview();
  });

  // ---------- 미리보기 ----------
  let prev: (Img & { close: () => void }) | null = null;
  let raf = 0;
  let token = 0;
  let loadToken = 0;

  function updateNav() {
    ($('pv-nav') as HTMLElement).hidden = files.length < 2;
    $('pv-count').textContent = `${pIdx + 1} / ${files.length}`;
    $('pv-name').textContent = files.length ? `미리보기 · ${files[pIdx].name}` : '미리보기 · 배경 패턴 (이미지를 추가하면 그 이미지로 보여줘요)';
    ($('pv-dl') as HTMLElement).hidden = !(files.length && resMap.has(files[pIdx]));
    rows.forEach((r, i) => r.classList.toggle('on', i === pIdx));
  }
  async function svgToImg(svg: string, w: number, h: number) {
    const url = URL.createObjectURL(new Blob([svg], { type: 'image/svg+xml' }));
    const img = new Image();
    img.src = url;
    await img.decode();
    return { src: img as CanvasImageSource, w, h, close: () => URL.revokeObjectURL(url) };
  }
  async function loadPreview() {
    const my = ++loadToken;
    let next: (Img & { close: () => void }) | null = null;
    try {
      if (files.length) {
        pIdx = Math.max(0, Math.min(pIdx, files.length - 1));
        next = await decode(files[pIdx]);
      } else {
        pIdx = 0;
        const [w, h] = patDims();
        next = await svgToImg(patSvg(patState.active, w, h), w, h);
      }
    } catch { next = null; }
    if (my !== loadToken) { next?.close(); return; }
    if (prev) prev.close();
    prev = next;
    updateNav();
    schedule();
  }
  $('pv-prev').addEventListener('click', () => { pIdx = (pIdx - 1 + files.length) % files.length; loadPreview(); });
  $('pv-next').addEventListener('click', () => { pIdx = (pIdx + 1) % files.length; loadPreview(); });
  $('pv-dl').addEventListener('click', () => {
    const r = files[pIdx] && resMap.get(files[pIdx]);
    if (!r) return;
    const a = document.createElement('a');
    a.href = r.url;
    a.download = r.name;
    document.body.append(a);
    a.click();
    a.remove();
  });

  async function ensureFonts() {
    const jobs: Promise<unknown>[] = [];
    const want = (font: string, weight: number, text: string) => {
      const f = `${weight} 40px ${fam(font)}`;
      const t = text.replace(/[\[\]{}]/g, '') || 'Ab';
      try { if (!document.fonts.check(f, t)) jobs.push(document.fonts.load(f, t)); } catch {}
    };
    secs.forEach((s) => s.text.trim() && want(s.font, s.weight, s.text));
    if (wm.text.trim()) want(wm.font, wm.weight, wm.text);
    await Promise.allSettled(jobs);
  }
  function schedule() {
    cancelAnimationFrame(raf);
    raf = requestAnimationFrame(drawPreview);
  }
  async function drawPreview() {
    const my = ++token;
    await ensureFonts();
    if (my !== token) return;
    const c = $('pv') as HTMLCanvasElement;
    const sw = prev ? prev.w : 1000;
    const sh = prev ? prev.h : 667;
    const W = Math.min(sw, 760);
    c.width = W;
    c.height = Math.max(1, Math.round((sh * W) / sw));
    compose(c.getContext('2d')!, prev ? prev.src : null, c.width, c.height, null, secs, wm);
  }
  document.fonts.ready.then(schedule);

  // ---------- 배경 패턴 ----------
  const patState = {
    sel: new Set<string>([PATTERNS[0][0]]),
    active: PATTERNS[0][0], // 미리보기에 보여줄 패턴 (마지막으로 누른 것)
    mode: 'solid', bg: '#243b6b', bg2: '#0b1530', angle: 135, fg: '#3d5a9c', scale: 1,
    size: '1000x1000', cw: 1000, ch: 1000,
  };
  const bgSpec = () => (patState.mode === 'grad' ? `grad:${patState.bg}:${patState.bg2}:${patState.angle}` : patState.bg);
  const patSvg = (id: string, w: number, h: number) => makeSvg(id, bgSpec(), patState.fg, w, h, patState.scale);

  // 이미지 크기: 목록에서 고르거나 직접 입력 (50~4000px)
  function patDims(): [number, number] {
    if (patState.size === 'custom') {
      const c = (v: number) => Math.max(50, Math.min(4000, Math.round(v) || 1000));
      return [c(patState.cw), c(patState.ch)];
    }
    const [w, h] = patState.size.split('x').map(Number);
    return [w, h];
  }

  // 추천 색상: 네 가지 색이 한 묶음이에요. 밝기순으로 정렬해서 배경(어두운 쪽 2색)과 패턴색(그다음 색)에 넣습니다.
  const PALETTES: [string, string[]][] = [
    ['미드나이트 블루', ['#0f172a', '#1e3a5f', '#38bdf8', '#e0f2fe']],
    ['딥 포레스트', ['#10261f', '#1d4d3b', '#4ade80', '#ecfccb']],
    ['와인', ['#2b0f1c', '#5b1a35', '#e11d74', '#fde2ec']],
    ['차콜 골드', ['#1a1a1d', '#34343b', '#d4a72c', '#f5e6b3']],
    ['오션', ['#06283d', '#1363df', '#47b5ff', '#dff6ff']],
    ['선셋', ['#3d1e6d', '#c2185b', '#ff7a45', '#ffd166']],
    ['라벤더 나이트', ['#1b1535', '#4c3a8a', '#9b8cf0', '#ece8ff']],
    ['민트 나이트', ['#0d2b2b', '#11595a', '#2dd4bf', '#ccfbf1']],
    ['레드 블랙', ['#14090b', '#5c0f1d', '#e63946', '#fdebec']],
    ['블루 그레이', ['#263447', '#3d5a80', '#98c1d9', '#e8f4fa']],
    ['쿨 그레이', ['#1f2933', '#52606d', '#9aa5b1', '#e4e7eb']],
    ['네온 퍼플', ['#0b0b17', '#7c3aed', '#22d3ee', '#f0abfc']],
    ['네온 라임', ['#101010', '#1f2937', '#a3e635', '#facc15']],
    ['레트로', ['#2f3e46', '#52796f', '#e9b44c', '#f2e8cf']],
    ['빈티지 브라운', ['#3e2a21', '#7a5230', '#c9a66b', '#f1e4c3']],
    ['얼스 톤', ['#4a3f35', '#8c7a6b', '#bfae9f', '#efe6dd']],
    ['웜 크림', ['#5a3e2b', '#a47148', '#e0b88a', '#fff3e0']],
    ['로즈 골드', ['#4a2c3a', '#b76e79', '#e8b4b8', '#fbeaec']],
    ['코랄 피치', ['#ff6b6b', '#ffa07a', '#ffe0b2', '#fff5e6']],
    ['선라이즈', ['#ff9a3c', '#ffcb74', '#fff1b8', '#fffbe6']],
    ['파스텔 핑크', ['#ff9ebb', '#ffc2d4', '#ffd6e0', '#fff0f5']],
    ['파스텔 민트', ['#7bc8a4', '#a7e6cf', '#d4f1e4', '#f2fff9']],
    ['파스텔 퍼플', ['#b197fc', '#d0bfff', '#e9d8fd', '#f8f0ff']],
    ['파스텔 스카이', ['#8ec5ff', '#b3d9ff', '#d6ecff', '#f2f9ff']],
  ];
  let palActive = -1;
  const lum = (h: string) => {
    const n = parseInt(h.slice(1), 16);
    return 0.2126 * ((n >> 16) & 255) + 0.7152 * ((n >> 8) & 255) + 0.0722 * (n & 255);
  };
  function renderPals() {
    $('pal-grid').innerHTML = PALETTES.map(([name, cols], i) =>
      `<button type="button" class="pal${i === palActive ? ' on' : ''}" data-pal="${i}" title="${name} · ${cols.join(' ')}" aria-label="${name}">${cols.map((c) => `<i style="background:${c}"></i>`).join('')}</button>`).join('');
  }
  $('pal-grid').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-pal]');
    if (!b) return;
    palActive = Number(b.dataset.pal);
    const sorted = [...PALETTES[palActive][1]].sort((a, c) => lum(a) - lum(c));
    patState.bg = sorted[0];
    patState.bg2 = sorted[1];
    patState.fg = sorted[2];
    $<HTMLInputElement>('pat-bg').value = patState.bg;
    $<HTMLInputElement>('pat-bg2').value = patState.bg2;
    $<HTMLInputElement>('pat-fg').value = patState.fg;
    renderPals();
    patChanged();
  });

  function renderPats() {
    $('pat-grid').innerHTML = PATTERNS.map(([id, name]) => {
      const svg = makeSvg(id, bgSpec(), patState.fg, 150, 150, patState.scale, 30);
      return `<button type="button" class="pat${patState.sel.has(id) ? ' on' : ''}" data-pat="${id}" title="${name}" aria-label="${name}" aria-pressed="${patState.sel.has(id)}" style="background-image:url('data:image/svg+xml,${encodeURIComponent(svg)}')"></button>`;
    }).join('');
    const n = patState.sel.size;
    $('pat-count').textContent = `${n}개 선택`;
    $('pat-add').textContent = n > 1 ? `선택한 패턴 ${n}개로 이미지 추가` : '이 패턴으로 이미지 추가';
  }
  const patChanged = () => { renderPats(); if (!files.length) loadPreview(); };

  $('pat-grid').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-pat]');
    if (!b) return;
    const id = b.dataset.pat!;
    if (patState.sel.has(id) && patState.sel.size > 1) {
      patState.sel.delete(id);
      if (patState.active === id) patState.active = [...patState.sel].pop()!;
    } else {
      patState.sel.add(id);
      patState.active = id;
    }
    patChanged();
  });
  $('pat-all').addEventListener('click', () => { PATTERNS.forEach(([id]) => patState.sel.add(id)); patChanged(); });
  $('pat-none').addEventListener('click', () => { patState.sel = new Set([patState.active]); patChanged(); });

  const showBgMode = () => {
    const grad = patState.mode === 'grad';
    ($('pat-bg2-w') as HTMLElement).hidden = !grad;
    ($('pat-angle-w') as HTMLElement).hidden = !grad;
    $('pat-bg-l').textContent = grad ? '배경색 1' : '배경색';
  };
  $('pat-bgmode').addEventListener('change', (e) => { patState.mode = (e.target as HTMLSelectElement).value; showBgMode(); patChanged(); });
  $('pat-bg').addEventListener('input', (e) => { patState.bg = (e.target as HTMLInputElement).value; palActive = -1; renderPals(); patChanged(); });
  $('pat-bg2').addEventListener('input', (e) => { patState.bg2 = (e.target as HTMLInputElement).value; palActive = -1; renderPals(); patChanged(); });
  $('pat-fg').addEventListener('input', (e) => { patState.fg = (e.target as HTMLInputElement).value; palActive = -1; renderPals(); patChanged(); });
  $('pat-angle').addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement;
    patState.angle = Number(el.value);
    el.closest('label')!.querySelector('b')!.textContent = el.value;
    patChanged();
  });
  $('pat-scale').addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement;
    patState.scale = Number(el.value);
    el.closest('label')!.querySelector('b')!.textContent = el.value;
    patChanged();
  });

  $('pat-size').addEventListener('change', (e) => {
    const v = (e.target as HTMLSelectElement).value;
    if (v === 'custom') {
      const [w, h] = patDims(); // 직접 입력으로 바꿀 때는 지금 크기에서 시작
      patState.cw = w;
      patState.ch = h;
      $<HTMLInputElement>('pat-w').value = String(w);
      $<HTMLInputElement>('pat-h').value = String(h);
    }
    patState.size = v;
    ['pat-w-w', 'pat-h-w', 'pat-custom-hint'].forEach((id) => (($(id) as HTMLElement).hidden = v !== 'custom'));
    if (!files.length) loadPreview();
  });
  $('pat-w').addEventListener('input', (e) => { patState.cw = Number((e.target as HTMLInputElement).value); if (!files.length) loadPreview(); });
  $('pat-h').addEventListener('input', (e) => { patState.ch = Number((e.target as HTMLInputElement).value); if (!files.length) loadPreview(); });
  const fixDims = () => {
    const [w, h] = patDims();
    $<HTMLInputElement>('pat-w').value = String(w);
    $<HTMLInputElement>('pat-h').value = String(h);
  };
  $('pat-w').addEventListener('change', fixDims);
  $('pat-h').addEventListener('change', fixDims);

  $('pat-add').addEventListener('click', () => {
    const [w, h] = patDims();
    const made = PATTERNS.filter(([id]) => patState.sel.has(id)).map(([id]) =>
      new File([patSvg(id, w, h)], `pattern-${id}-${w}x${h}.svg`, { type: 'image/svg+xml' }));
    addFiles(made);
  });

  // ---------- 변환 ----------
  const fmtEl = $<HTMLSelectElement>('fmt');
  const qEl = $<HTMLInputElement>('quality');
  const syncQ = () => {
    $('q-v').textContent = qEl.value;
    qEl.disabled = fmtEl.value === 'png';
  };
  qEl.addEventListener('input', syncQ);
  fmtEl.addEventListener('change', syncQ);
  syncQ();

  const MIME: Record<string, string> = { jpg: 'image/jpeg', png: 'image/png', webp: 'image/webp' };
  const EXT: Record<string, string> = { 'image/jpeg': 'jpg', 'image/png': 'png', 'image/webp': 'webp' };

  async function convert(file: File) {
    const fmt = fmtEl.value;
    const maxW = Number($<HTMLInputElement>('maxw').value) || Infinity;
    const maxH = Number($<HTMLInputElement>('maxh').value) || Infinity;
    const d = await decode(file);
    const scale = Math.min(1, maxW / d.w, maxH / d.h);
    const W = Math.max(1, Math.round(d.w * scale));
    const H = Math.max(1, Math.round(d.h * scale));
    const c = document.createElement('canvas');
    c.width = W;
    c.height = H;
    compose(c.getContext('2d')!, d.src, W, H, fmt === 'jpg' ? $<HTMLInputElement>('bgc').value : null, secs, wm);
    d.close();
    const blob = await new Promise<Blob | null>((res) => c.toBlob(res, MIME[fmt], Number(qEl.value) / 100));
    c.width = c.height = 0;
    if (!blob) throw new Error('변환 실패');
    return blob;
  }

  async function run() {
    if (running || !files.length) return;
    running = true;
    files.forEach(dropResult);
    renderFiles();
    await ensureFonts();
    const suffix = $<HTMLInputElement>('suffix').value.trim();
    let ok = 0, fail = 0, srcSum = 0, outSum = 0, warn = '';
    const t0 = Date.now();
    for (let i = 0; i < files.length; i++) {
      const f = files[i];
      curIdx = i;
      updateRow(i);
      $('rstatus').textContent = `${i + 1} / ${files.length}장 변환 중 · 소요시간 ${Math.round((Date.now() - t0) / 1000)}초`;
      try {
        const blob = await convert(f);
        const ext = EXT[blob.type] || fmtEl.value;
        if (blob.type !== MIME[fmtEl.value]) warn = '이 브라우저는 선택한 형식으로 저장하지 못해 PNG로 저장됐어요.';
        const name = f.name.replace(/\.[^.]+$/, '') + suffix + '.' + ext;
        resMap.set(f, { name, blob, url: URL.createObjectURL(blob) });
        srcSum += f.size;
        outSum += blob.size;
        ok++;
      } catch {
        failSet.add(f);
        fail++;
      }
      curIdx = -1;
      updateRow(i);
      if (i === pIdx) updateNav();
      $('rprog').style.width = ((i + 1) / files.length) * 100 + '%';
      await new Promise((r) => setTimeout(r, 0)); // 화면이 멈추지 않게 한 템포 쉽니다
    }
    const sec = Math.round((Date.now() - t0) / 1000);
    $('rstatus').textContent = `완료 · ${ok}장 변환${fail ? `, ${fail}장 실패` : ''} · ${kb(srcSum)} → ${kb(outSum)} · 소요시간 ${sec}초${warn ? ' · ' + warn : ''}`;
    running = false;
    ($('run') as HTMLButtonElement).disabled = !files.length;
    buildZips();
    updateNav();
  }
  $('run').addEventListener('click', run);

  $('zips').addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-zip]');
    if (!b) return;
    const n = Number(b.dataset.zip);
    const old = b.textContent;
    b.disabled = true;
    b.textContent = 'ZIP 만드는 중…';
    // 같은 이름이 있으면 (2), (3)을 붙입니다.
    const used = new Map<string, number>();
    const items = zipParts[n].map((r) => {
      const c = (used.get(r.name) || 0) + 1;
      used.set(r.name, c);
      return { name: c > 1 ? r.name.replace(/(\.[^.]+)$/, `(${c})$1`) : r.name, blob: r.blob };
    });
    const zip = await makeZip(items);
    const a = document.createElement('a');
    a.href = URL.createObjectURL(zip);
    a.download = zipParts.length > 1 ? `images_${n + 1}.zip` : 'images.zip';
    document.body.append(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(a.href), 4000);
    b.disabled = false;
    b.textContent = old;
  });

  renderPals();
  renderPats();
  renderFiles();
  loadPreview();
</script>
