---
import Base from '../../layouts/Base.astro';
---
<Base title="네이버 블로그 누락 체크" description="네이버 블로그 최근 글이 통합검색과 블로그탭에 노출되는지, 텍스트인지 이미지인지 확인합니다.">
  <div class="wrap">
    <section class="page-head">
      <h1>네이버 블로그 누락 체크</h1>
      <p>최근 글의 제목을 네이버에서 검색해 통합검색과 블로그탭 노출 여부를 확인합니다.</p>
    </section>

    <div class="card panel">
      <div class="row">
        <input id="blogId" class="field" type="text" placeholder="블로그 아이디 또는 주소 (예: myblogid)" aria-label="네이버 블로그 아이디" autocomplete="off" />
        <button id="go" class="btn btn-primary" type="button">조회하기</button>
      </div>
      <p class="err" id="error" hidden></p>
    </div>

    <div class="card" id="result" hidden>
      <div class="res-head">
        <div>
          <h2 id="blogTitle">-</h2>
          <a id="blogUrl" href="#" target="_blank" rel="noopener">-</a>
        </div>
        <div class="sum">
          <span class="badge b-gray" id="s-total">전체 0</span>
          <span class="badge b-green" id="s-main">통합 노출 0</span>
          <span class="badge b-blue" id="s-blog">블로그탭만 0</span>
          <span class="badge b-red" id="s-none">누락 0</span>
        </div>
      </div>
      <div class="prog"><div id="prog"></div></div>
      <div class="tbl-wrap">
        <table>
          <thead>
            <tr><th>상태</th><th>글 제목</th><th>발행일</th><th>통합검색</th><th>블로그탭</th><th>바로가기</th></tr>
          </thead>
          <tbody id="rows"></tbody>
        </table>
      </div>
      <div class="pager" id="pager"></div>
    </div>

    <section class="guide">
      <h2>결과 보는 법</h2>
      <h3>통합 노출 / 블로그탭만 / 누락</h3>
      <p>통합검색 결과에 글이 있으면 통합 노출, 통합검색에는 없고 블로그탭에만 있으면 블로그탭만, 둘 다 없으면 누락입니다.</p>
      <h3>텍스트와 이미지</h3>
      <p>검색 결과에서 글 제목 링크로 나오면 텍스트, 썸네일 이미지 링크로만 나오면 이미지로 표시합니다.</p>
      <h3>참고하세요</h3>
      <p>발행 직후의 글은 검색에 반영되기까지 시간이 걸려 누락으로 보일 수 있습니다. 최근 50개 글까지 확인하며, 네이버 화면 구조가 바뀌면 결과가 달라질 수 있습니다.</p>
    </section>
  </div>
</Base>

<script>
  type Hit = 'text' | 'image' | 'none' | 'error' | null;
  type Post = { title: string; logNo: string; pubDate: string; main: Hit; blog: Hit };

  const $ = (id: string) => document.getElementById(id)!;
  const PAGE = 10;
  let posts: Post[] = [];
  let page = 1;
  let blogId = '';

  const HIT: Record<string, [string, string]> = {
    text: ['텍스트', 'b-blue'],
    image: ['이미지', 'b-violet'],
    none: ['없음', 'b-gray'],
    error: ['확인 실패', 'b-amber'],
  };

  const esc = (s: string) =>
    s.replace(/[&<>"']/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[m]!);

  const found = (h: Hit) => h === 'text' || h === 'image';
  const kind = (p: Post) =>
    p.main === null || p.blog === null ? 'pending'
    : found(p.main) ? 'main'
    : found(p.blog) ? 'blog'
    : p.main === 'error' || p.blog === 'error' ? 'error'
    : 'none';
  const STATUS: Record<string, [string, string]> = {
    pending: ['확인 중', 'b-gray'],
    main: ['통합 노출', 'b-green'],
    blog: ['블로그탭만', 'b-blue'],
    none: ['누락', 'b-red'],
    error: ['확인 실패', 'b-amber'],
  };

  const searchUrl = (title: string, tab: boolean) =>
    `https://search.naver.com/search.naver?${tab ? 'ssc=tab.blog.all&' : ''}query=${encodeURIComponent(`"${title}"`)}`;

  const parseId = (v: string) => {
    const m = v.trim().match(/blog\.naver\.com\/([A-Za-z0-9_-]+)/i);
    return (m ? m[1] : v.trim()).replace(/^@/, '');
  };

  const fmtDate = (s: string) => {
    const d = new Date(s);
    return isNaN(+d) ? s : d.toLocaleString('ko-KR', { timeZone: 'Asia/Seoul', dateStyle: 'medium', timeStyle: 'short' });
  };

  function hitBadge(h: Hit) {
    const [label, cls] = h === null ? ['확인 중', 'b-gray'] : HIT[h];
    return `<span class="badge ${cls}">${label}</span>`;
  }

  function render() {
    const kinds = posts.map(kind);
    $('s-total').textContent = `전체 ${posts.length}`;
    $('s-main').textContent = `통합 노출 ${kinds.filter((k) => k === 'main').length}`;
    $('s-blog').textContent = `블로그탭만 ${kinds.filter((k) => k === 'blog').length}`;
    $('s-none').textContent = `누락 ${kinds.filter((k) => k === 'none').length}`;

    const slice = posts.slice((page - 1) * PAGE, page * PAGE);
    $('rows').innerHTML = slice.length
      ? slice.map((p) => {
          const [label, cls] = STATUS[kind(p)];
          return `<tr>
            <td><span class="badge ${cls}">${label}</span></td>
            <td class="title-cell">${esc(p.title)}</td>
            <td class="date-cell">${esc(fmtDate(p.pubDate))}</td>
            <td>${hitBadge(p.main)}</td>
            <td>${hitBadge(p.blog)}</td>
            <td class="links">
              <a href="https://blog.naver.com/${esc(blogId)}/${p.logNo}" target="_blank" rel="noopener">블로그글</a>
              <a href="${searchUrl(p.title, false)}" target="_blank" rel="noopener">통합검색</a>
              <a href="${searchUrl(p.title, true)}" target="_blank" rel="noopener">블로그탭</a>
            </td></tr>`;
        }).join('')
      : '<tr><td colspan="6" style="text-align:center;color:#6f7d97">조회된 글이 없습니다.</td></tr>';

    const pages = Math.ceil(posts.length / PAGE);
    $('pager').innerHTML = pages > 1
      ? Array.from({ length: pages }, (_, i) => `<button type="button" data-p="${i + 1}" class="${i + 1 === page ? 'on' : ''}">${i + 1}</button>`).join('')
      : '';
  }

  async function checkAll() {
    let next = 0, done = 0;
    const worker = async () => {
      while (next < posts.length) {
        const p = posts[next++];
        try {
          const qs = new URLSearchParams({ blogId, logNo: p.logNo, title: p.title });
          const d = await (await fetch(`/api/naver-check?${qs}`)).json();
          p.main = d.main || 'error';
          p.blog = d.blog || 'error';
        } catch {
          p.main = p.blog = 'error';
        }
        $('prog').style.width = (++done / posts.length) * 100 + '%';
        render();
      }
    };
    await Promise.all([worker(), worker(), worker()]);
  }

  async function run() {
    const err = $('error');
    err.hidden = true;
    blogId = parseId(($('blogId') as HTMLInputElement).value);
    if (!blogId) { err.textContent = '네이버 블로그 아이디를 입력하세요.'; err.hidden = false; return; }
    try { localStorage.setItem('naver_blog_id', blogId); } catch {}

    const btn = $('go') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = '조회 중…';
    try {
      const res = await fetch(`/api/naver-posts?blogId=${encodeURIComponent(blogId)}`);
      const d = await res.json();
      if (!res.ok || d.error) throw new Error(d.error || '조회에 실패했습니다.');

      posts = d.posts.map((p: Omit<Post, 'main' | 'blog'>) => ({ ...p, main: null, blog: null }));
      page = 1;
      $('blogTitle').textContent = d.blogTitle;
      const a = $('blogUrl') as HTMLAnchorElement;
      a.textContent = a.href = `https://blog.naver.com/${blogId}`;
      $('prog').style.width = '0';
      $('result').hidden = false;
      render();
      await checkAll();
    } catch (e) {
      err.textContent = (e as Error).message || '조회에 실패했습니다.';
      err.hidden = false;
    }
    btn.disabled = false;
    btn.textContent = '다시 조회';
  }

  $('go').addEventListener('click', run);
  $('blogId').addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') run(); });
  $('pager').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button');
    if (b) { page = Number(b.dataset.p); render(); }
  });
  try {
    const saved = localStorage.getItem('naver_blog_id');
    if (saved) ($('blogId') as HTMLInputElement).value = saved;
  } catch {}
</script>
