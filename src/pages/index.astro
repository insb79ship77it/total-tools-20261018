---
import Base from '../layouts/Base.astro';
import { tools, groups, groupKey, ICONS } from '../data/tools';
const featured = tools.filter((t) => t.primary);
---
<Base>
  <section class="hero">
    <div class="wrap">
      <div>
        <h1>자주 쓰는 웹 도구,<br /><em>토탈툴즈</em>에서 바로 쓰세요.</h1>
        <p>토탈툴즈(TTtools)에서는 속도 측정부터 IP·도메인 조회, 글자수 세기, 네이버 블로그 노출 확인까지. 가입도 설치도 필요 없습니다.</p>
        <div class="actions">
          <a class="btn btn-primary" href="/tools/speed/">속도 측정하기</a>
          <a class="btn btn-ghost" href="#all">전체 도구 보기</a>
        </div>
      </div>
      <div class="card">
        <div class="tools-head">
          <span class="ico"><svg viewBox="0 0 24 24"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4z"/></svg></span>
          <div><b>인기 도구</b><small>가장 많이 쓰는 {featured.length}가지</small></div>
        </div>
        {featured.map((t) => (
          <a class="tool-row" href={`/tools/${t.slug}/`}>
            <span class="ico"><svg viewBox="0 0 24 24" set:html={ICONS[t.icon]} /></span>
            <div><b>{t.name}</b><small>{t.desc}</small></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="all" id="all">
    <div class="wrap">
      <h2>전체 도구</h2>
      {groups.map((g) => (
        <div class={`group gx g-${groupKey[g]}`}>
          <h3 class="ghead">{g}<small>{tools.filter((t) => t.group === g).length}개</small></h3>
          <div class="grid">
            {tools.filter((t) => t.group === g).map((t) => (
              <a class="tl" href={`/tools/${t.slug}/`}>
                <b>{t.name}</b>
                <small>{t.desc}</small>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</Base>
